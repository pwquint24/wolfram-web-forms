Cell[CellGroupData[{

Cell["2. Define the FormFunction", "Section",ExpressionUUID->"98abfce5-e920-4c6c-8f76-e2e73c9f3a09"],

Cell["\<\
The form below asks for a country, a highlight color, and a zoom radius in \
miles. When submitted, it applies the action function to generate a centered \
GeoGraphics image. Here we are using the form {name, label}->type. 
You can either define your form as a separate formObject, and then insert it \
into the FormFunction, or simply include it in the form function. \
\>", "Text",
 CellChangeTimes->{{4.002004767413701*^9, 
  4.0020048330669937`*^9}},ExpressionUUID->"a60a9736-f85b-43e7-bf41-\
0fe2a6eb4097"],

Cell[BoxData[
 RowBox[{
  RowBox[{"formObject", " ", "=", " ", 
   RowBox[{"FormObject", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<country\>\"", ",", "\"\<Select a Country:\>\""}], "}"}],
         "->", 
        RowBox[{"\"\<Country\>\"", "->", "\"\<Japan\>\""}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<color\>\"", ",", "\"\<Highlight Color:\>\""}], "}"}], "->", 
        RowBox[{"\"\<Color\>\"", "->", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.85", ",", "0.2", ",", "0.2"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<zoom\>\"", ",", "\"\<Zoom Radius (miles):\>\""}], "}"}],
         "->", 
        RowBox[{
         RowBox[{"Restricted", "[", 
          RowBox[{"\"\<Integer\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"100", ",", "2000"}], "}"}]}], "]"}], "->", "500"}]}]}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", " ", 
     RowBox[{"AppearanceRules", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Title\>\"", "->", "\"\<Country Geo-Focus Form\>\""}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Description\>\"", 
         "->", "\"\<Demonstrating semantic Interpreter types (Country, Color, \
Restricted).\>\""}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SubmitLabel\>\"", "->", "\"\<Generate Map\>\""}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002004645180995*^9, 4.002004697738049*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"1169a4cf-add5-4bb8-a5f7-caaee3685839"],

Cell[BoxData[
 RowBox[{
  RowBox[{"form", "=", 
   RowBox[{"FormFunction", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{"formObject", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"params", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"params", "[", "\"\<color\>\"", "]"}], ",", 
           RowBox[{"GeoDisk", "[", 
            RowBox[{
             RowBox[{"params", "[", "\"\<country\>\"", "]"}], ",", 
             RowBox[{"Quantity", "[", 
              RowBox[{
               RowBox[{"params", "[", "\"\<zoom\>\"", "]"}], 
               ",", "\"\<Miles\>\""}], "]"}]}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"GeoRange", "->", 
          RowBox[{"Quantity", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"params", "[", "\"\<zoom\>\"", "]"}], "*", "1.5"}], 
            ",", "\"\<Miles\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
         "      ", 
         RowBox[{"GeoCenter", "->", 
          RowBox[{"params", "[", "\"\<country\>\"", "]"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"ImageSize", "->", "500"}]}], "\[IndentingNewLine]", "    ", 
        "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", "\"\<PNG\>\""}], "\[IndentingNewLine]", 
    "  ", "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002002268019252*^9, 4.0020022685634003`*^9}, {
  4.002004690843424*^9, 4.002004713938298*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"04a60abc-6983-43a8-814b-de9760f15c4f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"4cd40ec6-097d-4d21-ba09-b3fe2fa511fc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Deploy to the Wolfram Cloud", "Section",ExpressionUUID->"8c6069b3-3dbc-453d-aa77-45cbe9b30568"],

Cell["\<\
Deploy the form to your Wolfram Cloud account. The returned CloudObject \
contains the live public URL. \
\>", "Text",ExpressionUUID->"79cdbcfd-86d9-4f4d-9012-39447277b3e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"co", "=", 
  RowBox[{"CloudDeploy", "[", 
   RowBox[{"form", ",", 
    RowBox[{"Permissions", "->", "\"\<Public\>\""}]}], "]"}]}]], "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"0cce51fd-adea-4e8b-aace-ad7988bb2347"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"CloudObject", "[", 
   TemplateBox[{
    "\"https://www.wolframcloud.com/obj/833140ae-982e-48de-9e51-cc3578dfec24\"\
", "https://www.wolframcloud.com/obj/833140ae-982e-48de-9e51-cc3578dfec24"},
    "HyperlinkURL"], "]"}],
  CloudObject[
  "https://www.wolframcloud.com/obj/833140ae-982e-48de-9e51-cc3578dfec24"],
  SelectWithContents->True]], "Output",
 CellChangeTimes->{4.0019135670564404`*^9, 4.002002279528925*^9, 
  4.002004726080719*^9},
 CellLabel->"Out[85]=",ExpressionUUID->"deeea616-8413-441d-beb1-d0942437e7c5"]
}, Open  ]],

Cell["You can view the URL directly: ", "CodeText",ExpressionUUID->"f914f9e5-6366-46ff-a1d9-a95b5e20e956"],

Cell[BoxData[
 RowBox[{"co", "[", "\"\<URL\>\"", "]"}]], "Input",ExpressionUUID->"dc134a79-546d-45a8-bb2d-536ea0e50aba"],

Cell["\<\
Click the resulting link or copy the URL into your web browser to test the \
form. Notice:\
\>", "Text",ExpressionUUID->"a5cf7f98-c54c-444b-9192-1bb0eed5e4f4"],

Cell["\<\
1. The country field supports natural language and knowledgebase entities.\
\>", "Text",ExpressionUUID->"fe55dbf7-f4dd-4bb5-8671-cc03ba70f470"],

Cell["2. The color field opens a browser-native color picker.", "Text",ExpressionUUID->"98c1d743-33ce-4add-b5b5-686176bcdfe2"],

Cell["3. The zoom field enforces bounds between 100 and 2000. ", "Text",ExpressionUUID->"a2c1f579-113f-4020-9e09-2e23725ceabd"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7625f4e5-7228-4f5a-990d-b8998517b25e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Delete the Cloud Object", "Section",ExpressionUUID->"edf4537c-0be0-4590-bb7a-0f52e51a0bec"],

Cell["\<\
Evaluate the following cell to un-deploy and delete the cloud object from \
your account: \
\>", "CodeText",ExpressionUUID->"16b85864-7fef-4cfb-9ae1-bea957ddd5e3"],

Cell[BoxData[
 RowBox[{"DeleteObject", "[", "co", "]"}]], "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"be40cc8e-b9cf-4bd8-a9dc-9a220605452e"]
}, Open  ]]
}, Open  ]]
