Cell["Instant Web Forms with Semantic Interpreters", "Title",ExpressionUUID->"c603e2f5-d087-4d3b-8d3e-0b02a2182c57"],

Cell[TextData[{
 "This notebook demonstrates how to create and deploy an instant web form to \
the Wolfram Cloud using ",
 Cell[BoxData[
  TemplateBox[{
   "FormFunction", "paclet:ref/FormFunction", 
    "https://reference.wolfram.com/language/ref/FormFunction.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
