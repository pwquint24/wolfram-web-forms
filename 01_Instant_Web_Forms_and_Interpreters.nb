Cell[CellGroupData[{

Cell["2. Define the FormFunction", "Section",ExpressionUUID->"98abfce5-e920-4c6c-8f76-e2e73c9f3a09"],

Cell[TextData[{
 "The form below asks for a country, a highlight color, and a zoom radius in \
miles. When submitted, it applies the action function to generate a centered ",
 Cell[BoxData[
  TemplateBox[{
   "GeoGraphics", "paclet:ref/GeoGraphics", 
    "https://reference.wolfram.com/language/ref/GeoGraphics.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "00061566-afec-415f-a31f-e11d5133cb6d"],
 " image. Here we are using the form {name, label}->type. \nYou can either \
define your form as a separate formObject, and then insert it into the \
FormFunction, or simply include it in the form function. "
}], "Text",
 CellChangeTimes->{{4.002004767413701*^9, 
  4.0020048330669937`*^9}},ExpressionUUID->"a60a9736-f85b-43e7-bf41-\
0fe2a6eb4097"],

Cell[BoxData[
 RowBox[{
  RowBox[{"formObject", " ", "=", " ", 
   RowBox[{"FormObject", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<country\>\"", ",", "\"\<Select a Country:\>\""}], "}"}],
         "->", 
        RowBox[{"\"\<Country\>\"", "->", "\"\<Japan\>\""}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<color\>\"", ",", "\"\<Highlight Color:\>\""}], "}"}], "->", 
        RowBox[{"\"\<Color\>\"", "->", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.85", ",", "0.2", ",", "0.2"}], "]"}]}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<zoom\>\"", ",", "\"\<Zoom Radius (miles):\>\""}], "}"}],
         "->", 
        RowBox[{
         RowBox[{"Restricted", "[", 
          RowBox[{"\"\<Integer\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"100", ",", "2000"}], "}"}]}], "]"}], "->", "500"}]}]}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", " ", 
     RowBox[{"AppearanceRules", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Title\>\"", "->", "\"\<Country Geo-Focus Form\>\""}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Description\>\"", 
         "->", "\"\<Demonstrating semantic Interpreter types (Country, Color, \
Restricted).\>\""}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SubmitLabel\>\"", "->", "\"\<Generate Map\>\""}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002004645180995*^9, 4.002004697738049*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"1169a4cf-add5-4bb8-a5f7-caaee3685839"],

Cell[BoxData[
 RowBox[{
  RowBox[{"form", "=", 
   RowBox[{"FormFunction", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{"formObject", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"params", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"GeoGraphics", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"params", "[", "\"\<color\>\"", "]"}], ",", 
           RowBox[{"GeoDisk", "[", 
            RowBox[{
             RowBox[{"params", "[", "\"\<country\>\"", "]"}], ",", 
             RowBox[{"Quantity", "[", 
              RowBox[{
               RowBox[{"params", "[", "\"\<zoom\>\"", "]"}], 
               ",", "\"\<Miles\>\""}], "]"}]}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"GeoRange", "->", 
          RowBox[{"Quantity", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"params", "[", "\"\<zoom\>\"", "]"}], "*", "1.5"}], 
            ",", "\"\<Miles\>\""}], "]"}]}], ",", "\[IndentingNewLine]", 
         "      ", 
         RowBox[{"GeoCenter", "->", 
          RowBox[{"params", "[", "\"\<country\>\"", "]"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"ImageSize", "->", "500"}]}], "\[IndentingNewLine]", "    ", 
        "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", "\"\<PNG\>\""}], "\[IndentingNewLine]", 
    "  ", "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002002268019252*^9, 4.0020022685634003`*^9}, {
  4.002004690843424*^9, 4.002004713938298*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"04a60abc-6983-43a8-814b-de9760f15c4f"],

