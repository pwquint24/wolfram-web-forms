Notebook[{

Cell[CellGroupData[{
Cell["Instant Web Forms with Semantic Interpreters", "Title",ExpressionUUID->"c603e2f5-d087-4d3b-8d3e-0b02a2182c57"],

Cell["\<\
This notebook demonstrates how to create and deploy an instant web form to \
the Wolfram Cloud using FormFunction and CloudDeploy. \
\>", "Text",ExpressionUUID->"df3175be-2948-48c4-8139-1ca645cf1f50"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
