 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"1afacd70-6743-44af-ba64-ca56d9b7f171"],

Cell[CellGroupData[{

Cell["1. Concepts Demonstrated", "Section",ExpressionUUID->"98e8e8e3-669d-420b-b6b0-125e74aba476"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"FormFunction", "[", 
   RowBox[{"formspec", ",", "func", ",", "fmt"}], "]"}]], "InlineWL", "Input",
  
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,
  FontWeight->Bold,ExpressionUUID->"397bce0c-a7aa-47c2-90de-44b7a7baa689"],
 ": Creates a submittable web form that evaluates an action function when \
submitted."
}], "Item",ExpressionUUID->"dbeb6772-7ce6-45cc-9f44-8accfddda894"],

Cell[CellGroupData[{

Cell["\<\
The Interpreter Framework: Wolfram Web Forms parse and validate user inputs \
into rich symbolic Wolfram expressions automatically:\
\>", "Item",ExpressionUUID->"02fdb1e8-8685-406f-88be-1dcfa1853181"],

Cell[TextData[{
 Cell[BoxData["\"\<Country\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "037364ba-2cf8-4cb5-b818-ab3a2a3074aa"],
 ": Recognizes country names via the Wolfram Knowledgebase and returns ",
 Cell[BoxData[
  RowBox[{"Entity", "[", 
   RowBox[{"\"\<Country\>\"", ",", "..."}], "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "12540622-9a1e-483a-b4f0-ee0991a2825f"],
 "."
}], "Subitem",ExpressionUUID->"deb52ea9-069a-4166-9a3c-35af63e3fbb0"],

Cell[TextData[{
 Cell[BoxData["\"\<Color\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "6b63a61c-1657-4577-962e-b744bbb7fe90"],
 ": Provides an HTML5 color picker and returns a native ",
 "RGBColor",
 "."
}], "Subitem",ExpressionUUID->"37e6aaba-aede-4399-af65-1444827c568d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Restricted", "[", 
   RowBox[{"\"\<Integer\>\"", ",", 
    RowBox[{"{", 
     RowBox[{"min", ",", "max"}], "}"}]}], "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "ed0e417c-c0a5-4470-aee2-d297fce6ecc1"],
 ": Validates that input is an integer within the specified range."
}], "Subitem",ExpressionUUID->"e28a8ddf-cc2d-45fe-96c4-f9b0c52974e0"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Defaults and Labels",
  FontWeight->Bold],
 ": Using ",
 Cell[BoxData[Cell["{\"key\", \"Display Label\"} -> type -> defaultValue",
   Background->None,ExpressionUUID->"7341e63b-981d-427a-90bc-f4ddad776a8a"]], 
  "InlineCode",ExpressionUUID->"35f56ce3-b20a-4c17-8054-4649bbf10779"],
 " syntax."
}], "Item",ExpressionUUID->"1edbf00e-f8a2-41f0-a963-c4359bd81d70"],

Cell["\<\
CloudDeploy: Deploys the form as an active web application in the Wolfram \
Cloud.\
\>", "Item",ExpressionUUID->"8efb732e-5e7a-4300-9d29-2ba84960a41c"],

Cell["\<\
DeleteObject: Removes the deployed cloud object when it is no longer needed.\
\>", "Item",ExpressionUUID->"d910fe14-6bb7-4ff5-8050-8f700da3af28"],

