Cell["Try It in the Browser", "Subsection",ExpressionUUID->"8a93723b-1882-42d7-99ae-e58189654816"],

Cell[TextData[{
 "1. Open ",
 Cell[BoxData[Cell["co1",
   Background->None,ExpressionUUID->"f027040b-621b-4785-990f-45ff02e5c397"]], 
  "InlineCode",ExpressionUUID->"4fd92a5f-3927-477b-b44d-5a59631f90b3"],
 ". Notice the banner image in the title, the styled description, and the \
logo placed beside the heading in the layout."
}], "Text",ExpressionUUID->"391fe01f-6685-4a39-992a-a4611f7556a8"],

Cell[TextData[{
 "2. Open ",
 Cell[BoxData[Cell["co2",
   Background->None,ExpressionUUID->"a837e6ef-e35a-4f7c-9afc-3f8ebba1452a"]], 
  "InlineCode",ExpressionUUID->"4dc8d7cf-db30-48d2-a581-ab69b9dca78a"],
 ". The photo field renders an upload control. Choose an image file, enter a \
name and role, and submit. The result returns a PNG of the composited ID \
badge. "
}], "Text",ExpressionUUID->"bdef495b-bce1-4f16-b9cb-5482c15123d6"],

