 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"771bcb2c-2e40-489f-9926-c2b36a29ca12"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2. Example 1 \[LongDash] Branding with a Banner Title and an Inline Logo\
\>", "Section",ExpressionUUID->"d6e28409-b49b-4cc3-be99-54c27ec3c8ee"],

Cell["\<\
First, build two image assets: a rasterized banner for the form title and a \
small triangular logo for the inline layout. \
\>", "Text",ExpressionUUID->"b32d986a-15a0-4abe-9276-76a4fb076be1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "A", " ", "rasterized", " ", "banner", " ", "image", " ", "used", " ", 
    "as", " ", "the", " ", 
    RowBox[{"form", "'"}], "s", " ", "title"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"banner", "=", 
     RowBox[{"Rasterize", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Darker", "[", "Blue", "]"}], ",", 
             RowBox[{"Rectangle", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "300"}], ",", 
                 RowBox[{"-", "40"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"300", ",", "40"}], "}"}]}], "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<ACME CONFERENCE 2024\>\"", ",", "White", ",", 
               "Bold", ",", "26", ",", 
               RowBox[{"FontFamily", "->", "\"\<Arial\>\""}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"{", 
            RowBox[{"Orange", ",", 
             RowBox[{"Rectangle", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "300"}], ",", "40"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"300", ",", "46"}], "}"}]}], "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "  ", "}"}], ",", 
         RowBox[{"ImageSize", "->", 
          RowBox[{"{", 
           RowBox[{"600", ",", "92"}], "}"}]}], ",", 
         RowBox[{"PlotRangePadding", "->", "None"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"ImageSize", "->", 
        RowBox[{"{", 
         RowBox[{"600", ",", "92"}], "}"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "A", " ", "small", " ", "inline", " ", "logo", " ", "for", " ", "the", " ",
      "layout"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"logo", "=", 
     RowBox[{"Rasterize", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "    ", 
          RowBox[{
           RowBox[{"EdgeForm", "[", "White", "]"}], ",", 
           RowBox[{"FaceForm", "[", "Orange", "]"}], ",", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"RegularPolygon", "[", "3", "]"}], ",", 
           "\[IndentingNewLine]", "    ", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<A\>\"", ",", "White", ",", "Bold", ",", "22"}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"-", "0.15"}]}], "}"}]}], "]"}]}], 
          "\[IndentingNewLine]", "  ", "}"}], ",", 
         RowBox[{"ImageSize", "->", "90"}], ",", 
         RowBox[{"Background", "->", 
          RowBox[{"Darker", "[", "Blue", "]"}]}]}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"ImageSize", "->", "90"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"b89f4ec2-5f68-4519-940c-5b1b80ee498d"],

Cell[TextData[{
 "Now define a registration form. The banner is passed to ",
 Cell[BoxData["\"\<Title\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "190399c8-0313-4e3c-bb29-844da4cc96ef"],
 " in ",
 "AppearanceRules",
 ", and the logo is placed in the ",
 "FormLayoutFunction",
 " beside a heading: "
}], "CodeText",ExpressionUUID->"0ea22f0e-3cec-4811-8205-2b3275ad0962"],

Cell[BoxData[
 RowBox[{
  RowBox[{"form", "=", 
   RowBox[{"FormFunction", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<name\>\"", ",", "\"\<Full Name:\>\""}], "}"}], 
        "->", "\"\<String\>\""}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<role\>\"", ",", "\"\<Role:\>\""}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Attendee\>\"", ",", "\"\<Speaker\>\"", 
          ",", "\"\<Sponsor\>\"", ",", "\"\<Staff\>\""}], "}"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<color\>\"", ",", "\"\<Badge Color:\>\""}], "}"}], "->", 
        
        RowBox[{"\"\<Color\>\"", "->", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.2", ",", "0.4", ",", "0.8"}], "]"}]}]}]}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"params", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Panel", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<Registration Confirmed\>\"", ",", "Bold", ",", 
               "18", ",", 
               RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{"Spacer", "[", "5", "]"}], ",", "\[IndentingNewLine]", 
             "        ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Name: \>\"", ",", "Bold"}], "]"}], ",", 
                RowBox[{"params", "[", "\"\<name\>\"", "]"}]}], "}"}], "]"}], 
             ",", "\[IndentingNewLine]", "        ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Role: \>\"", ",", "Bold"}], "]"}], ",", 
                RowBox[{"params", "[", "\"\<role\>\"", "]"}]}], "}"}], "]"}], 
             ",", "\[IndentingNewLine]", "        ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{"\"\<Badge Color: \>\"", ",", "Bold"}], "]"}], ",", 
                "\[IndentingNewLine]", "          ", 
                RowBox[{"Graphics", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"params", "[", "\"\<color\>\"", "]"}], ",", 
                    RowBox[{"Rectangle", "[", "]"}]}], "}"}], ",", 
                  RowBox[{"ImageSize", "->", 
                   RowBox[{"{", 
                    RowBox[{"18", ",", "18"}], "}"}]}]}], "]"}]}], "}"}], 
              "]"}]}], "\[IndentingNewLine]", "      ", "}"}], ",", 
           RowBox[{"Alignment", "->", "Left"}], ",", 
           RowBox[{"Spacings", "->", "1"}]}], "]"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"ImageSize", "->", "360"}]}], "\[IndentingNewLine]", "    ", 
        "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"AppearanceRules", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Title\>\"", "->", "banner"}], ",", "\[IndentingNewLine]",
         "    ", 
        RowBox[{"\"\<Description\>\"", "->", 
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Register for the conference by filling out the form \
below.\>\"", ",", "Italic", ",", "Gray"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SubmitLabel\>\"", "->", "\"\<Register\>\""}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"FormLayoutFunction", "->", 
      RowBox[{"Function", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{"Column", "[", 
        RowBox[{"{", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            RowBox[{"logo", ",", 
             RowBox[{"Spacer", "[", "15", "]"}], ",", 
             RowBox[{"Style", "[", 
              
              RowBox[{"\"\<Attendee Registration\>\"", ",", "Bold", ",", "18",
                ",", 
               RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}]}], "}"}], "]"}], 
          ",", "\[IndentingNewLine]", "      ", "Delimiter", ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"\"\<name\>\"", ",", "\"\<Label\>\""}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"\"\<name\>\"", ",", "\"\<Control\>\""}], "]"}]}], 
               "}"}], ",", "\[IndentingNewLine]", "        ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"\"\<role\>\"", ",", "\"\<Label\>\""}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"\"\<role\>\"", ",", "\"\<Control\>\""}], "]"}]}], 
               "}"}], ",", "\[IndentingNewLine]", "        ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"\"\<color\>\"", ",", "\"\<Label\>\""}], "]"}], ",", 
                
                RowBox[{"#", "[", 
                 RowBox[{"\"\<color\>\"", ",", "\"\<Control\>\""}], "]"}]}], 
               "}"}]}], "\[IndentingNewLine]", "      ", "}"}], ",", 
            RowBox[{"Alignment", "->", "Left"}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], 
         "\[IndentingNewLine]", "    ", "}"}], "]"}], "\[IndentingNewLine]", 
       "  ", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"PageTheme", "->", "\"\<White\>\""}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002017107317175*^9, 4.002017109935811*^9}, {
  4.0020174658235073`*^9, 4.002017478481297*^9}, {4.002017673827551*^9, 
  4.002017704054302*^9}, {4.002017776400262*^9, 4.0020177853989697`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"3592a0ec-a631-40dc-9796-09da535fe42b"],

