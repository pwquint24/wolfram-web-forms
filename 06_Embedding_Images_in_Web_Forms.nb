Cell[CellGroupData[{

Cell["3. Example 2 \[LongDash] Uploading an Image to Generate an ID Badge", \
"Section",ExpressionUUID->"18acb06e-88b7-4c7f-8874-d9c325033bc9"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Image\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "3eb9b97f-b94d-43ad-a838-fc0f81fe1dba"],
 " interpreter adds an upload field. The action function receives the \
uploaded photo as an ",
 "Image",
 ", composites it into a badge graphic, and returns it as a PNG: "
}], "Text",ExpressionUUID->"4fbbc921-20f2-482c-9d82-d70b487d47c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"badgeForm", "=", 
   RowBox[{"FormFunction", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<photo\>\"", ",", "\"\<Upload Your Photo:\>\""}], "}"}],
          "->", "\"\<Image\>\""}], "}"}], ",", "\[IndentingNewLine]", "    ", 
       
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<name\>\"", ",", "\"\<Full Name:\>\""}], "}"}], "->", 
         RowBox[{"\"\<String\>\"", "->", "\"\<Ada Lovelace\>\""}]}], "}"}], ",",
        "\[IndentingNewLine]", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<role\>\"", ",", "\"\<Job Title:\>\""}], "}"}], "->", 
         RowBox[{"\"\<String\>\"", "->", "\"\<Engineer\>\""}]}], "}"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<accent\>\"", ",", "\"\<Accent Color:\>\""}], "}"}], "->", 
         RowBox[{"\"\<Color\>\"", "->", 
          RowBox[{"Darker", "[", "Blue", "]"}]}]}], "}"}]}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"params", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"White", ",", 
             RowBox[{"Rectangle", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", "5"}], "}"}], ",", 
               RowBox[{"RoundingRadius", "->", "0.25"}]}], "]"}]}], "}"}], ",",
            "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"params", "[", "\"\<accent\>\"", "]"}], ",", 
             RowBox[{"Rectangle", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "4.2"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", "5"}], "}"}], ",", 
               RowBox[{"RoundingRadius", "->", 
                RowBox[{"{", 
                 RowBox[{"0.25", ",", "0.25", ",", "0", ",", "0"}], "}"}]}]}],
               "]"}]}], "}"}], ",", "\[IndentingNewLine]", "      ", 
           RowBox[{"Inset", "[", 
            RowBox[{
             RowBox[{"params", "[", "\"\<photo\>\"", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "2.85"}], "}"}], ",", "Center", ",", 
             RowBox[{"{", 
              RowBox[{"3.2", ",", "2.7"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"params", "[", "\"\<name\>\"", "]"}], ",", "Bold", ",",
                "22", ",", 
               RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1.15"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"params", "[", "\"\<role\>\"", "]"}], ",", "14", ",", 
               "Gray"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "0.62"}], "}"}]}], "]"}]}], 
