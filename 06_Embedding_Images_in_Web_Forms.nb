Notebook[{

Cell[CellGroupData[{
Cell["Embedding Images in Web Forms", "Title",ExpressionUUID->"b89e2cf3-3cd1-4452-a19a-a6dc66c8b279"],

Cell[TextData[{
 "This notebook builds on the earlier examples to show how to embed images \
into Wolfram Language web forms. Images can appear in three distinct places: \
(1) the form chrome (title, description, and submit button), (2) inside a \
custom ",
 "FormLayoutFunction",
 " layout, and (3) as user-uploaded content via the ",
 Cell[BoxData["\"\<Image\>\""], "InlineWL",ExpressionUUID->
  "a975fc50-8066-41b2-8526-02ceaf3e0564"],
 " interpreter that is then composited into an image result. "
}], "Text",ExpressionUUID->"7188f038-a38b-4023-8c69-da4f92c20e15"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"4110b1ec-7b81-4322-ab8d-9ecc3b0df646"],

Cell[CellGroupData[{

Cell["1. Concepts Demonstrated", "Section",ExpressionUUID->"dd3c39ca-5ed4-4924-b0c8-0fc6568f09c9"],

Cell[TextData[{
 "Images as non-textual ",
 "AppearanceRules",
 " values",
 ": The ",
 Cell[BoxData["\"\<Title\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "5c7e253c-18d1-4e18-a22e-f2aa98a126c8"],
 ", ",
 Cell[BoxData["\"\<Description\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "d35441dd-0248-4136-a6de-238d86f6dc6d"],
 ", and ",
 Cell[BoxData["\"\<SubmitLabel\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "1d834816-3ab2-46c7-b7ea-e40e90cd9149"],
 " appearance rules do not have to be plain strings. They accept any \
renderable Wolfram expression such as ",
 "Image",
 ", ",
 "Graphics",
 ", or ",
 "Style",
 ". The form engine rasterizes these values and embeds them directly in the \
generated HTML, which makes them ideal for logos, banners, and branded \
forms."
}], "Item",ExpressionUUID->"7945ea9c-d184-4bbf-a629-44ba9a3e1fe4"],

Cell["\<\
Images and graphics inside FormLayoutFunction: Because a FormLayoutFunction \
simply returns a Wolfram layout expression, you can mix arbitrary graphics \
and images with form controls using Row, Column, Grid, and Delimiter.\
\>", "Item",ExpressionUUID->"793fd3a7-eeee-49c5-9e13-a70f43b5f542"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Image\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "fa587938-0495-44f8-a599-02b4a9d5314f"],
 " interpreter",
 ": A field declared with interpreter ",
 Cell[BoxData["\"\<Image\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "d28e8b6a-d84b-4240-af82-cc546ccb7da7"],
 " renders a file-upload control. On submission, the uploaded file is \
delivered to the action function as a native ",
 "Image",
 " expression that can be processed, transformed, or composited."
}], "Item",ExpressionUUID->"37f18069-738d-427d-b6bc-501c1056a97b"],

Cell[TextData[{
 StyleBox["Image output",
  FontWeight->Bold],
 ": The third argument of ",
 "FormFunction",
 " or ",
 "FormPage",
 " can be an image format such as ",
 Cell[BoxData["\"\<PNG\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "ccbb5f37-5674-4808-b71d-9585851baf1f"],
 ", ",
 Cell[BoxData["\"\<JPEG\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "9ae2ab53-526a-4c63-9c67-5a952fec155e"],
 ", or ",
 Cell[BoxData["\"\<GIF\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "60c50e92-99d5-4946-8490-90b708946775"],
 ", so the result is returned as an image."
}], "Item",ExpressionUUID->"01f6933c-79eb-4216-a930-ead1c8e90589"],

Cell[TextData[{
 StyleBox["Cloud deployment and cleanup",
  FontWeight->Bold],
 ": Using ",
 "CloudDeploy",
 " and ",
 "DeleteObject",
 "."
}], "Item",ExpressionUUID->"6302293e-1689-4972-8568-eb06d6251ae9"],

