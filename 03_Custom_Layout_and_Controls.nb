Cell[TextData[{
 StyleBox["Interactivity Model",
  FontWeight->Bold],
 ": Unlike desktop notebook sliders which use client-side ",
 Cell[BoxData[
  TemplateBox[{
   "Dynamic", "paclet:ref/Dynamic", 
    "https://reference.wolfram.com/language/ref/Dynamic.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
