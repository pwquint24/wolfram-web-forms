Cell[BoxData[
 RowBox[{
  RowBox[{"processFunc", " ", "=", " ", 
   RowBox[{"Function", "[", 
    RowBox[{"data", ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "baseRate", ",", "userCost", ",", "discount", ",", "supportCost", ",",
          "totalMonthly", ",", "totalAnnual"}], "}"}], ",", 
       "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"baseRate", "=", 
         RowBox[{"data", "[", "\"\<tier\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"userCost", "=", 
         RowBox[{
          RowBox[{"data", "[", "\"\<users\>\"", "]"}], "*", "15"}]}], ";", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"discount", "=", 
         RowBox[{"data", "[", "\"\<billingCycle\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"supportCost", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"data", "[", "\"\<supportAddon\>\"", "]"}], "]"}], ",", 
           "50", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", "      ", 
        RowBox[{"totalMonthly", "=", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"baseRate", "+", "userCost", "+", "supportCost"}], ")"}],
             "*", "discount"}], ",", "0.01"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"totalAnnual", "=", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"totalMonthly", "*", "12"}], ",", "0.01"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"Panel", "[", "\[IndentingNewLine]", "        ", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{"{", "\[IndentingNewLine]", "          ", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"\"\<Estimate for \>\"", " ", "<>", " ", 
                RowBox[{"data", "[", "\"\<companyName\>\"", "]"}]}], ",", 
               "Bold", ",", "18"}], "]"}], ",", "\[IndentingNewLine]", 
             "          ", 
             RowBox[{"Spacer", "[", "10", "]"}], ",", "\[IndentingNewLine]", 
             "          ", 
             RowBox[{"Grid", "[", 
              RowBox[{
               RowBox[{"{", "\[IndentingNewLine]", "            ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"\"\<Base Tier Rate:\>\"", ",", 
                   RowBox[{"\"\<$\>\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", "baseRate", "]"}], " ", "<>", 
                    " ", "\"\</mo\>\""}]}], "}"}], ",", "\[IndentingNewLine]",
                  "            ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\"\<Seat Add-on (\>\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"data", "[", "\"\<users\>\"", "]"}], "]"}], " ", "<>",
                     " ", "\"\< users):\>\""}], ",", 
                   RowBox[{"\"\<$\>\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", "userCost", "]"}], " ", "<>", 
                    " ", "\"\</mo\>\""}]}], "}"}], ",", "\[IndentingNewLine]",
                  "            ", 
                 RowBox[{"{", 
                  RowBox[{"\"\<Support Add-on:\>\"", ",", 
                   RowBox[{"\"\<$\>\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", "supportCost", "]"}], " ", "<>", 
                    " ", "\"\</mo\>\""}]}], "}"}], ",", "\[IndentingNewLine]",
                  "            ", 
                 RowBox[{"{", 
                  RowBox[{"\"\<Effective Monthly Cost:\>\"", ",", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"\"\<$\>\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{"totalMonthly", ",", 
                    RowBox[{"{", 
                    RowBox[{"6", ",", "2"}], "}"}]}], "]"}], "]"}]}], ",", 
                    "Bold", ",", "16", ",", 
                    RowBox[{"Darker", "[", "Green", "]"}]}], "]"}]}], "}"}], ",",
                  "\[IndentingNewLine]", "            ", 
                 RowBox[{"{", 
                  RowBox[{"\"\<Projected Annual Cost:\>\"", ",", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"\"\<$\>\"", " ", "<>", " ", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{"totalAnnual", ",", 
                    RowBox[{"{", 
                    RowBox[{"6", ",", "2"}], "}"}]}], "]"}], "]"}]}], ",", 
                    "Bold", ",", "16"}], "]"}]}], "}"}]}], 
                "\[IndentingNewLine]", "          ", "}"}], ",", 
               RowBox[{"Alignment", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"Left", ",", "Right"}], "}"}], ",", "Center"}], 
                 "}"}]}], ",", 
               RowBox[{"Spacings", "->", 
                RowBox[{"{", 
                 RowBox[{"3", ",", "1"}], "}"}]}]}], "]"}]}], 
            "\[IndentingNewLine]", "        ", "}"}], "]"}], ",", 
          "\[IndentingNewLine]", "        ", 
          RowBox[{"ImageSize", "->", "450"}]}], "\[IndentingNewLine]", 
         "      ", "]"}]}]}], "\[IndentingNewLine]", "    ", "]"}]}], 
    "\[IndentingNewLine]", "  ", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002002058439474*^9, 4.002002066646014*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"8110ef18-6645-488c-855f-4ba97e76a5ec"],

