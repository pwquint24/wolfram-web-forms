Cell["2. Define the FormObject and FormFunction", "Section",ExpressionUUID->"48d6e390-fd28-461d-9523-5752ffe234b2"],

Cell["\<\
Here we construct an Enterprise Subscription Pricing Calculator with a custom \
two-column grid layout, styled dividers, and explicit controls. \
\>", "Text",ExpressionUUID->"9f13b1d9-2194-4213-a6da-cd2dc1784969"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"53ffc020-c0e1-4000-ad0c-23225f9fe38f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fieldList", " ", "=", " ", 
   RowBox[{"{", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"\"\<companyName\>\"", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\"\<Interpreter\>\"", "->", "\"\<String\>\""}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Label\>\"", "->", "\"\<Company Name\>\""}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Hint\>\"", "->", "\"\<Acme Corporation\>\""}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Required\>\"", "->", "True"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Input\>\"", "->", "\"\<Acme Corporation\>\""}]}], 
       "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"\"\<tier\>\"", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\"\<Interpreter\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Starter\>\"", "->", "29"}], ",", 
           RowBox[{"\"\<Professional\>\"", "->", "99"}], ",", 
           RowBox[{"\"\<Enterprise\>\"", "->", "299"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Label\>\"", "->", "\"\<Subscription Tier\>\""}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Control\>\"", "->", "RadioButtonBar"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Input\>\"", "->", "\"\<Professional\>\""}]}], 
       "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<users\>\"", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\"\<Interpreter\>\"", "->", 
         RowBox[{"Restricted", "[", 
          RowBox[{"\"\<Integer\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "100"}], "}"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Label\>\"", "->", "\"\<Seat Count (1 - 100)\>\""}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Control\>\"", "->", "Slider"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Input\>\"", "->", "10"}]}], "\[IndentingNewLine]", 
       "    ", "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"\"\<billingCycle\>\"", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\"\<Interpreter\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Monthly\>\"", "->", "1.0"}], ",", 
           RowBox[{"\"\<Annual (15% discount)\>\"", "->", "0.85"}]}], "}"}]}],
         ",", "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Label\>\"", "->", "\"\<Billing Cycle\>\""}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Control\>\"", "->", "PopupMenu"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Input\>\"", "->", "\"\<Monthly\>\""}]}], 
       "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"\"\<supportAddon\>\"", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\"\<Interpreter\>\"", "->", "\"\<Boolean\>\""}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Label\>\"", 
