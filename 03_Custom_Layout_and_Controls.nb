Cell[CellGroupData[{
Cell["\<\
Custom Layouts and Controls with FormObject and FormLayoutFunction\
\>", "Title",ExpressionUUID->"38b0dabf-40c2-433a-a790-bfee2516786f"],

Cell[TextData[{
 "This notebook demonstrates how to build professional web forms with custom \
layouts using ",
 Cell[BoxData[
  TemplateBox[{
   "FormObject", "paclet:ref/FormObject", 
    "https://reference.wolfram.com/language/ref/FormObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "a273c746-595d-4c15-96c1-2f9edacc280c"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
   "FormLayoutFunction", "paclet:ref/FormLayoutFunction", 
    "https://reference.wolfram.com/language/ref/FormLayoutFunction.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "1c328f04-8ddc-4219-a8c8-8b99e15a728a"],
 ", and how to assign concrete UI controls like sliders, radio buttons, popup \
menus, and checkboxes. \nThe Slider control here doesn\[CloseCurlyQuote]t \
work. "
}], "Text",
 CellChangeTimes->{{4.001914960481988*^9, 
  4.001914969236319*^9}},ExpressionUUID->"cde97bff-4a9c-4173-9879-\
9759c1e0049b"],

