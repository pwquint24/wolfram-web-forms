          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "fce25d28-4b4b-43ac-87f1-12b680e5ca92"],
 ", an HTML5 web form slider conforms to HTTP request/response: moving the \
slider changes the control's value, which is sent to the server upon clicking \
Submit."
}], "Subitem",ExpressionUUID->"359b6833-bb3a-4a2e-9d3b-428a1bacc19d"]
}, Open  ]],

