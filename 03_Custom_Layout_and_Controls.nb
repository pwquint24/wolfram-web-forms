                 "]"}], ",", "Bold"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"\"\<supportAddon\>\"", ",", "\"\<Control\>\""}], 
               "]"}]}], "}"}]}], "\[IndentingNewLine]", "      ", "}"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"Alignment", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Right", ",", "Left"}], "}"}], ",", "Center"}], "}"}]}],
           ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"Dividers", "->", 
           RowBox[{"{", 
            RowBox[{"None", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2", "->", 
                RowBox[{"GrayLevel", "[", "0.85", "]"}]}], ",", 
               RowBox[{"3", "->", 
                RowBox[{"GrayLevel", "[", "0.85", "]"}]}], ",", 
               RowBox[{"4", "->", 
                RowBox[{"GrayLevel", "[", "0.85", "]"}]}], ",", 
               RowBox[{"5", "->", 
                RowBox[{"GrayLevel", "[", "0.85", "]"}]}]}], "}"}]}], "}"}]}],
           ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"Spacings", "->", 
           RowBox[{"{", 
            RowBox[{"2", ",", "1.5"}], "}"}]}]}], "\[IndentingNewLine]", 
         "    ", "]"}], "\[IndentingNewLine]", "  ", "]"}]}], ",", 
      "\[IndentingNewLine]", " ", 
      RowBox[{"AppearanceRules", "->", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Title\>\"", 
          "->", "\"\<Enterprise Pricing Calculator\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Description\>\"", 
          "->", "\"\<Custom layout using FormObject and FormLayoutFunction \
with HTML5 controls.\>\""}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<SubmitLabel\>\"", 
          "->", "\"\<Calculate Estimate\>\""}]}], "\[IndentingNewLine]", "  ",
         "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
