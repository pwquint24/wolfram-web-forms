        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Control\>\"", "->", "Checkbox"}], ",", 
        "\[IndentingNewLine]", "      ", 
        RowBox[{"\"\<Input\>\"", "->", "False"}]}], "\[IndentingNewLine]", 
       "    ", "|>"}]}]}], "\[IndentingNewLine]", "  ", "}"}]}], 
  ";"}]], "Input",
