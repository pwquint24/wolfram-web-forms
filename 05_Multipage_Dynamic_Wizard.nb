", "https://www.wolframcloud.com/obj/61a6eb1f-5d85-4068-89f7-6190f562ceea"},
    "HyperlinkURL"], "]"}],
  CloudObject[
  "https://www.wolframcloud.com/obj/61a6eb1f-5d85-4068-89f7-6190f562ceea"],
