 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"73aa7d8c-675c-4ae7-9dfa-cf7997facd11"],

Cell[CellGroupData[{

Cell["1. Concepts Demonstrated", "Section",ExpressionUUID->"397feff8-ad79-4544-8645-ca6ffde096d0"],

Cell[TextData[{
 StyleBox["Multi-Page Form Specification",
  FontWeight->Bold],
 ": Providing a list of page specifications to ",
 Cell[BoxData[
  TemplateBox[{
   "FormFunction", "paclet:ref/FormFunction", 
    "https://reference.wolfram.com/language/ref/FormFunction.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "36c28679-bddf-44c5-bca3-39a2b0e19912"],
 ":"
}], "Item",ExpressionUUID->"0d134bec-feb2-4593-b921-b7ec562b41a0"],

Cell[TextData[{
 "  ",
 Cell[BoxData[
  RowBox[{"FormFunction", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"page1", ",", "page2", ",", "..."}], "}"}], ",", 
    "actionFunction"}], "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "b879c2d3-9670-4611-a703-5f4007238b7a"]
}], "Text",ExpressionUUID->"926ca8fe-2c71-46c9-94ff-ff031b9931bc"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Dynamic Page Generation via Pure Functions",
  FontWeight->Bold],
 ":"
}], "Item",ExpressionUUID->"5351b666-dce8-4c50-846a-f1c9c012a87c"],

Cell[TextData[{
 "The second and subsequent pages can be pure functions of all inputs \
gathered so far: ",
 Cell[BoxData[
  RowBox[{"Function", "[", 
   RowBox[{"prevInputs", ",", "..."}], "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "fb4fb205-7d57-4c40-97bb-0c0e8cf4ebb3"],
 "."
}], "Subitem",ExpressionUUID->"abe8f06f-7405-4d42-afe9-492230f362bf"],

Cell[TextData[{
 "For example, if page 1 asks for a count ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "beb97ea3-0776-4aad-8a93-c5c03003c58f"],
 ", page 2 can generate exactly ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1cf683bc-4c4e-401a-b546-87c67daec36b"],
 " custom input fields using ",
 Cell[BoxData[
  TemplateBox[{
   "Table", "paclet:ref/Table", 
    "https://reference.wolfram.com/language/ref/Table.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "7bc3d1bb-bacb-4073-82d6-667089013621"],
 "."
}], "Subitem",ExpressionUUID->"8ec997a0-56a8-48b8-b841-087dbb78ce3a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Automatic Wizard Navigation",
  FontWeight->Bold],
 ":"
}], "Item",ExpressionUUID->"650d8aab-a256-4213-9e9b-b5602ec63b94"],

Cell[TextData[{
 "The Wolfram Cloud form engine automatically provides ",
 StyleBox["\"Next\"",
  FontWeight->Bold],
 " and ",
 StyleBox["\"Back\"",
  FontWeight->Bold],
 " navigation between intermediate pages, and a ",
 StyleBox["\"Submit\"",
  FontWeight->Bold],
 " button on the final page."
}], "Subitem",ExpressionUUID->"8239b74a-4bc7-4307-863a-6119e31ad34c"],

Cell["State is preserved across wizard steps.", "Subitem",ExpressionUUID->"05054561-3b35-472f-8a09-eb91da33430f"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Aggregated Submission",
  FontWeight->Bold],
 ": The final action function receives an ",
 Cell[BoxData[
  TemplateBox[{
   "Association", "paclet:ref/Association", 
    "https://reference.wolfram.com/language/ref/Association.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
