Cell[CellGroupData[{

Cell["3. Deploy to the Wolfram Cloud", "Section",ExpressionUUID->"9b3a9c25-ff0e-4ceb-8aeb-363ee483c6d9"],

Cell["Deploy the multi-page wizard to the Wolfram Cloud: ", "CodeText",ExpressionUUID->"b2fd5ab0-3a08-43a7-960e-932002236ae8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"co", "=", 
  RowBox[{"CloudDeploy", "[", 
   RowBox[{"form", ",", 
    RowBox[{"Permissions", "->", "\"\<Public\>\""}]}], "]"}]}]], "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"41aacf7e-4437-4264-b777-e5c3f448d016"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"CloudObject", "[", 
