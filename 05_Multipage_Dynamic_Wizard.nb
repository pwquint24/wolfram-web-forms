 CellChangeTimes->{4.002004507934291*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"6e51eadd-d195-4f9b-be82-1ad6f7bbd50e"]
}, Open  ]],

Cell["Retrieve the URL: ", "CodeText",ExpressionUUID->"b90a02a6-17f3-4b71-bfc6-d462c2c374e0"],

Cell[BoxData[
 RowBox[{"co", "[", "\"\<URL\>\"", "]"}]], "Input",ExpressionUUID->"7fb21004-af8d-4081-a720-a0659d7830c1"],

Cell[CellGroupData[{

Cell["Try It in the Browser:", "Subsection",ExpressionUUID->"c9472a2b-40d3-4244-b44c-7faf800acf33"],

Cell[TextData[{
 "1. Open the URL. Page 1 asks for the ",
 StyleBox["Project Name",
  FontWeight->Bold],
 " and ",
 StyleBox["Number of Team Members",
  FontWeight->Bold],
 " (default: 2)."
}], "Text",ExpressionUUID->"ff74fa26-a2f0-4930-8013-0f288ce79df7"],

Cell[TextData[{
 "2. Enter a project name, change the count to ",
 StyleBox["3",
  FontWeight->Bold],
 ", and click ",
 StyleBox["Next",
  FontWeight->Bold],
 "."
}], "Text",ExpressionUUID->"5137e838-5215-422a-b034-ef63f837ff6a"],

Cell[TextData[{
 "3. Page 2 dynamically presents exactly ",
 StyleBox["3 input fields",
  FontWeight->Bold],
 " for Member 1, Member 2, and Member 3."
}], "Text",ExpressionUUID->"409e41d7-e4c8-4ecb-ae6d-c88423411b75"],

Cell["\<\
4. Fill in the member details and submit to see the compiled project roster. \
\
\>", "Text",ExpressionUUID->"0f7cb32f-8a3d-4931-808c-34441c214c62"],

