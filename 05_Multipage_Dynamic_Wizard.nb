Cell[CellGroupData[{

Cell["2. Define the Multi-Page Wizard", "Section",ExpressionUUID->"68810c79-dc13-4e3f-bf95-48aab888faa2"],

Cell["In this example: ", "Text",ExpressionUUID->"f9bef80a-0d55-4daa-874c-3e9cbd7d4a7a"],

Cell[TextData[{
 StyleBox["Page 1",
  FontWeight->Bold],
 ": Requests the project name and the number of team members (1 to 4)."
}], "Item",ExpressionUUID->"a2839fab-dc0b-4de2-9dcc-7f0083d6fb4d"],

Cell[TextData[{
 StyleBox["Page 2",
  FontWeight->Bold],
 ": A pure function that inspects ",
 Cell[BoxData[Cell["#teamSize",
   Background->None,ExpressionUUID->"cc5de65f-7639-4f01-8239-e1bedd466fb2"]], 
  "InlineCode",ExpressionUUID->"5f3bae7a-7e64-4c55-8f70-88a362ba72f0"],
 " and generates a dedicated text input for each member."
}], "Item",ExpressionUUID->"2291b32e-13e1-4891-b97c-d5de2fbc3aa9"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Action Function",
  FontWeight->Bold],
 ": Compiles all responses into a formatted project manifest and team roster \
table."
}], "Item",ExpressionUUID->"792f2939-c198-4b4e-a922-1df091e91ce7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"form", "=", 
   RowBox[{"FormFunction", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Page", " ", "1"}], ":", " ", 
        RowBox[{"Project", " ", "Metadata"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<projectName\>\"", ",", "\"\<Project Name:\>\""}], 
           "}"}], "->", "\"\<String\>\""}], ",", "\[IndentingNewLine]", 
         "      ", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<teamSize\>\"", 
            ",", "\"\<Number of Team Members (1-4):\>\""}], "}"}], "->", 
          RowBox[{
           RowBox[{"Restricted", "[", 
            RowBox[{"\"\<Integer\>\"", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "4"}], "}"}]}], "]"}], "->", "2"}]}]}], 
        "\[IndentingNewLine]", "    ", "}"}], ",", "\[IndentingNewLine]", 
       "    ", "\[IndentingNewLine]", "    ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Page", " ", "2"}], ":", " ", 
         RowBox[{
         "Dynamically", " ", "Generated", " ", "Fields", " ", "Based", " ", 
          "on", " ", "Page", " ", "1"}]}], " ", "*)"}], "\[IndentingNewLine]",
        "    ", 
       RowBox[{"Function", "[", 
        RowBox[{"prev", ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", "        ", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\"\<member_\>\"", " ", "<>", " ", 
               RowBox[{"ToString", "[", "i", "]"}]}], ",", 
              RowBox[{"\"\<Member \>\"", " ", "<>", " ", 
               RowBox[{"ToString", "[", "i", "]"}], " ", "<>", 
               " ", "\"\< (Name and Role):\>\""}]}], "}"}], 
            "->", "\"\<String\>\""}], ",", "\[IndentingNewLine]", "        ", 
           
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"prev", "[", "\"\<teamSize\>\"", "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "      ", "]"}]}], "\[IndentingNewLine]", 
        "    ", "]"}]}], "\[IndentingNewLine]", "  ", "}"}], ",", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{"Final", " ", "Action", " ", 
       RowBox[{"Function", ":", " ", 
        RowBox[{
        "Processes", " ", "Data", " ", "From", " ", "All", " ", "Steps"}]}]}],
       " ", "*)"}], "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"allData", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "members", "}"}], ",", "\[IndentingNewLine]", "      ", 
         
         RowBox[{
          RowBox[{"members", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"allData", "[", 
              RowBox[{"\"\<member_\>\"", " ", "<>", " ", 
               RowBox[{"ToString", "[", "i", "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"allData", "[", "\"\<teamSize\>\"", "]"}]}], "}"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", "      ", 
          RowBox[{"Panel", "[", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"Column", "[", 
             RowBox[{"{", "\[IndentingNewLine]", "          ", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\<Project Roster: \>\"", " ", "<>", " ", 
                  RowBox[{"allData", "[", "\"\<projectName\>\"", "]"}]}], ",",
                  "Bold", ",", "16"}], "]"}], ",", "\[IndentingNewLine]", 
               "          ", 
               RowBox[{"Spacer", "[", "5", "]"}], ",", "\[IndentingNewLine]", 
               "          ", 
               RowBox[{"Grid", "[", "\[IndentingNewLine]", "            ", 
                RowBox[{
                 RowBox[{
                 "Prepend", "[", "\[IndentingNewLine]", "              ", 
                  RowBox[{
                   RowBox[{"MapIndexed", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], ",", "#1"}], "}"}], 
                    " ", "&"}], ",", "members"}], "]"}], ",", 
                   "\[IndentingNewLine]", "              ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<#\>\"", ",", "\"\<Team Member\>\""}], 
                    "}"}]}], "\[IndentingNewLine]", "            ", "]"}], ",",
                  "\[IndentingNewLine]", "            ", 
                 RowBox[{"Dividers", "->", "All"}], ",", 
                 "\[IndentingNewLine]", "            ", 
                 RowBox[{"FrameStyle", "->", 
                  RowBox[{"GrayLevel", "[", "0.8", "]"}]}], ",", 
                 "\[IndentingNewLine]", "            ", 
                 RowBox[{"ItemStyle", "->", 
                  RowBox[{"{", 
                   RowBox[{"Automatic", ",", 
                    RowBox[{"{", 
                    RowBox[{"1", "->", "Bold"}], "}"}]}], "}"}]}], ",", 
                 "\[IndentingNewLine]", "            ", 
                 RowBox[{"Spacings", "->", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "1"}], "}"}]}]}], "\[IndentingNewLine]", 
                "          ", "]"}]}], "\[IndentingNewLine]", "        ", 
              "}"}], "]"}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"ImageSize", "->", "420"}]}], "\[IndentingNewLine]", 
           "      ", "]"}]}]}], "\[IndentingNewLine]", "    ", "]"}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"AppearanceRules", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Title\>\"", 
         "->", "\"\<Dynamic Multi-Page Project Setup Wizard\>\""}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Description\>\"", 
         "->", "\"\<Page 2 dynamically generates member fields matching the \
count chosen on Page 1.\>\""}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SubmitLabel\>\"", 
         "->", "\"\<Generate Project Manifest\>\""}]}], "\[IndentingNewLine]",
        "  ", "|>"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"PageTheme", "->", "\"\<White\>\""}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002004490987451*^9, 4.002004493133526*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"5c24a530-4f3a-4d15-b938-8711f8d552c9"]
}, Open  ]],

