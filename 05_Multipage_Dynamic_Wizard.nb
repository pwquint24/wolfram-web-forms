Cell[CellGroupData[{
Cell["Multi-Page Dynamic Form Wizards", "Title",ExpressionUUID->"b676a1e5-ff77-475a-833b-05c7e9523bec"],

Cell["\<\
This notebook demonstrates how to construct multi-page dynamic form workflows \
(wizards) where subsequent pages are generated programmatically based on user \
inputs from earlier pages. \
\>", "Text",ExpressionUUID->"0f275d51-7850-43a8-95a1-9fb9a41e291f"],

