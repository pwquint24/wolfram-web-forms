Cell[CellGroupData[{

Cell["3. Deploy to the Wolfram Cloud", "Section",ExpressionUUID->"133665e6-d6ba-477f-ac30-adb02d862a4d"],

Cell["Deploy the form: ", "CodeText",ExpressionUUID->"1ad4fb09-db66-44b3-a271-2a45096ec6e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"co", "=", 
  RowBox[{"CloudDeploy", "[", 
   RowBox[{"form", ",", 
    RowBox[{"Permissions", "->", "\"\<Public\>\""}]}], "]"}]}]], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"6d66f5b6-0259-45b0-b98b-e22c72ea06e2"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"CloudObject", "[", 
   TemplateBox[{
    "\"https://www.wolframcloud.com/obj/cfb9fd3d-d57c-430d-a637-083695fa5f04\"\
", "https://www.wolframcloud.com/obj/cfb9fd3d-d57c-430d-a637-083695fa5f04"},
    "HyperlinkURL"], "]"}],
  CloudObject[
  "https://www.wolframcloud.com/obj/cfb9fd3d-d57c-430d-a637-083695fa5f04"],
  SelectWithContents->True]], "Output",
 CellChangeTimes->{4.0020042830432158`*^9, 4.0020043800118923`*^9},
 CellLabel->"Out[73]=",ExpressionUUID->"330bba8a-0591-43aa-b7f2-133f913de829"]
}, Open  ]],

Cell["Retrieve the URL: ", "CodeText",ExpressionUUID->"9a3d8a76-e5e7-4e23-b9a7-17257c03d78a"],

Cell[BoxData[
 RowBox[{"co", "[", "\"\<URL\>\"", "]"}]], "Input",ExpressionUUID->"fba522ee-ff8a-4e37-8139-b8bcc0fb4d1d"],

Cell[CellGroupData[{

Cell["Try It in the Browser:", "Subsection",ExpressionUUID->"e909d0e0-85bf-45e0-a96f-86343f5c2adf"],

Cell[TextData[{
 "1. Open the URL. Note that initially, only the ",
 StyleBox["Category",
  FontWeight->Bold],
 " dropdown and ",
 StyleBox["Notes",
  FontWeight->Bold],
 " field are displayed."
}], "Text",ExpressionUUID->"ef98c8b0-955f-4fc8-aceb-415302ea25ef"],

Cell[TextData[{
 "2. Select ",
 StyleBox["\"Science\"",
  FontWeight->Bold],
 "."
}], "Text",ExpressionUUID->"bffb4957-0785-45df-bff1-9a3b0969d6c1"],

Cell[TextData[{
 "3. Notice the form briefly reloads automatically: the ",
 StyleBox["Topic",
  FontWeight->Bold],
 " dropdown appears populated with ",
 StyleBox["Physics",
  FontSlant->Italic],
 ", ",
 StyleBox["Chemistry",
  FontSlant->Italic],
 ", ",
 StyleBox["Biology",
  FontSlant->Italic],
 ", and ",
 StyleBox["Astronomy",
  FontSlant->Italic],
 "."
}], "Text",ExpressionUUID->"c437cc72-74d6-415a-a2bf-ff4e43a4ceb2"],

Cell[TextData[{
 "4. Change the category to ",
 StyleBox["\"Arts\"",
  FontWeight->Bold],
 "\[LongDash]the topic dropdown immediately updates to ",
 StyleBox["Literature",
  FontSlant->Italic],
 ", ",
 StyleBox["Music",
  FontSlant->Italic],
 ", ",
 StyleBox["Painting",
  FontSlant->Italic],
 ", and ",
 StyleBox["Cinema",
  FontSlant->Italic],
 ". "
}], "Text",ExpressionUUID->"de40f73a-4da4-46d3-8eef-6ed61f6ee8ab"],

