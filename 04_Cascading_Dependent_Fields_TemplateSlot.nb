Notebook[{

Cell[CellGroupData[{
Cell["Cascading Dependent Fields with TemplateSlot and Autosubmit", "Title",ExpressionUUID->"53682ab3-d2a3-4c8c-9a43-a5134d80163a"],

Cell["\<\
This notebook demonstrates how to create dynamic web forms with \
interdependent fields using the Wolfram Templating Engine (TemplateSlot and \
TemplateExpression). \
\>", "Text",ExpressionUUID->"1e3e585a-2e1b-4b93-95c9-61e0b7977e4c"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"c15de6e0-a9c0-4e60-ae5b-9eb21bb27c20"],

Cell[CellGroupData[{

Cell["1. Concepts Demonstrated", "Section",ExpressionUUID->"5863aa0a-5377-4f96-bf89-7f0c40b2abb5"],

Cell[CellGroupData[{

Cell[TextData[{
 "Why ",
 Cell[BoxData[
  RowBox[{"Dynamic", "[", "...", "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "e4b20f3f-a3ac-4108-acb4-2abf62c52e33"],
 " Does Not Work in Web Forms"
}], "Subsection",ExpressionUUID->"fcffdab8-c46a-4f53-880c-004fe65b37c7"],

Cell["\<\
In desktop Mathematica notebooks, Dynamic creates a live client-side reactive \
binding within the front-end preemptive evaluation loop.\
\>", "Text",ExpressionUUID->"f7604dd1-9bb4-4ff3-8a73-89392347da13"],

Cell[TextData[{
 "However, ",
 StyleBox["web forms adhere to HTTP request/response semantics",
  FontWeight->Bold],
 ". When you place ",
 Cell[BoxData[
  RowBox[{"Dynamic", "[", "x", "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "9683c971-96a8-41f4-9732-9b250abe214e"],
 " inside a web form: "
}], "Text",ExpressionUUID->"72793333-6e0c-4519-943c-c54d8307d095"],

Cell[TextData[{
 "It is ",
 StyleBox["not",
  FontWeight->Bold],
 " converted into client-side reactive JavaScript."
}], "Item",ExpressionUUID->"617585ff-ced7-4e58-b15b-e2f8493c836a"],

Cell[TextData[{
 "It is treated as a held expression that renders literally into the HTML \
(e.g. ",
 Cell[BoxData[Cell["value=\"Dynamic[0]\"",
   Background->None,ExpressionUUID->"a7d34bd8-f460-40b6-bc9f-f0f6e645cb48"]], 
  "InlineCode",ExpressionUUID->"f9b822f9-54b5-4601-9099-48e10ee8075b"],
 ")."
}], "Item",ExpressionUUID->"192f6f23-753a-4d83-9b1a-ee324eabe7be"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
How Web Forms Achieve Interdependent Fields: The Template Slot Engine\
\>", "Subsection",ExpressionUUID->"b7925ba9-9ec5-40fe-a3bf-137f9291a10f"],

Cell["\<\
Wolfram Web Forms achieve field-to-field dynamic interdependence through \
server-side cascading: \
\>", "Text",ExpressionUUID->"12f1cf0f-cf04-49c7-9d34-5002cfbf8aee"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"TemplateSlot", "[", "\"\<fieldName\>\"", "]"}]], "InlineWL", 
  "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,
  FontWeight->Bold,ExpressionUUID->"b3988c60-4c69-406b-a727-326706f5e7e7"],
 ": References the current value of an earlier field."
}], "Item",ExpressionUUID->"455bdfd7-ea44-4552-9e4d-38151caf855a"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"TemplateExpression", "[", "...", "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,
  FontWeight->Bold,ExpressionUUID->"6476fa77-fbf1-45b9-a912-9a9b004d9da1"],
 ": Dynamically computes choices, ranges, or controls based on earlier field \
values."
}], "Item",ExpressionUUID->"b41867ff-e2a6-4399-b0ff-ac83abf61598"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Under the Hood: The Autosubmit Mechanism", "Subsection",ExpressionUUID->"1ff8f7d4-de6c-4ff6-ad51-3954669c0c83"],

Cell[TextData[{
 "1. ",
 StyleBox["Initial Page Load",
  FontWeight->Bold],
 ": When the Wolfram Engine sees that field ",
 Cell[BoxData["\"\<topic\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "c16ebcee-b03d-4377-8fba-944c7b2f0f43"],
 " depends on ",
 Cell[BoxData[
  RowBox[{"TemplateSlot", "[", "\"\<category\>\"", "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "2b554192-9c6f-4582-8c92-fa20afe32173"],
 ", it ",
 StyleBox["withholds",
  FontWeight->Bold],
 " ",
 Cell[BoxData["\"\<topic\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "e4c70aa2-e9be-44d5-aad2-9f73c8d2f5cf"],
 " from the initial HTML."
}], "Text",ExpressionUUID->"05003ce8-b022-400b-9e53-e845dba5db78"],

Cell[TextData[{
 "2. ",
 StyleBox["Autosubmit Tagging",
  FontWeight->Bold],
 ": The prerequisite ",
 Cell[BoxData["\"\<category\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "9ba6e666-d704-4723-8b70-813a769b63e2"],
 " input is tagged with ",
 Cell[BoxData[Cell["data-autosubmit=\"autosubmit\"",
   Background->None,ExpressionUUID->"5feb5014-78e4-465d-8084-268f30449871"]], 
  "InlineCode",ExpressionUUID->"1587d4cf-fdbf-4100-9774-efdd46746b33"],
 "."
}], "Text",ExpressionUUID->"7a74fea7-ce49-44bc-92b5-80ff94333f56"],

Cell[TextData[{
 "3. ",
 StyleBox["Triggered Submission",
  FontWeight->Bold],
 ": As soon as the user selects a category, the browser automatically submits \
an HTTP request to the Wolfram Cloud."
}], "Text",ExpressionUUID->"27935906-aef6-4e89-aefd-cb163c0710b1"],

Cell[TextData[{
 "4. ",
 StyleBox["Server Re-evaluation",
  FontWeight->Bold],
 ": The engine evaluates the ",
 "TemplateExpression",
 " with the chosen category and returns the updated form, now unlocking the \
populated ",
 Cell[BoxData["\"\<topic\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "1bdfcfef-f4a9-4886-9210-6da1920cd46e"],
 " field. "
}], "Text",ExpressionUUID->"d9dae258-15d6-4bd4-b937-61d87bce7e7f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"f562466d-13ae-465e-8548-8266d8ae00fa"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Define the Form with Cascading Fields", "Section",ExpressionUUID->"64400821-6615-4d27-8515-7b1e2bc9751d"],

Cell["\<\
In this example, choosing a category (\"Science\", \"Arts\", or \"Sports\") \
automatically triggers a server-side round trip to populate the corresponding \
list of topics. \
\>", "Text",ExpressionUUID->"48c7f798-1048-413e-a122-ebc0c084f03f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"form", "=", 
   RowBox[{"FormFunction", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"\"\<category\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Science\>\"", ",", "\"\<Arts\>\"", 
          ",", "\"\<Sports\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"\"\<topic\>\"", "->", 
        RowBox[{"TemplateExpression", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{"TemplateSlot", "[", "\"\<category\>\"", "]"}], ",", 
           "\[IndentingNewLine]", "        ", "\"\<Science\>\"", ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Physics\>\"", ",", "\"\<Chemistry\>\"", 
             ",", "\"\<Biology\>\"", ",", "\"\<Astronomy\>\""}], "}"}], ",", 
           "\[IndentingNewLine]", "        ", "\"\<Arts\>\"", ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Literature\>\"", ",", "\"\<Music\>\"", 
             ",", "\"\<Painting\>\"", ",", "\"\<Cinema\>\""}], "}"}], ",", 
           "\[IndentingNewLine]", "        ", "\"\<Sports\>\"", ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Football\>\"", ",", "\"\<Basketball\>\"", 
             ",", "\"\<Tennis\>\"", ",", "\"\<Swimming\>\""}], "}"}], ",", 
           "\[IndentingNewLine]", "        ", "_", ",", 
           RowBox[{"{", "}"}]}], "\[IndentingNewLine]", "      ", "]"}], 
         "\[IndentingNewLine]", "    ", "]"}]}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"\"\<notes\>\"", "->", "\"\<String\>\""}]}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"params", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Panel", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"Column", "[", 
          RowBox[{"{", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Selection Summary\>\"", ",", "Bold", ",", "16"}], 
             "]"}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"Spacer", "[", "5", "]"}], ",", "\[IndentingNewLine]", 
            "        ", 
            RowBox[{"Grid", "[", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", "          ", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<Selected Category:\>\"", ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"params", "[", "\"\<category\>\"", "]"}], ",", 
                    "Bold"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
                "          ", 
                RowBox[{"{", 
                 RowBox[{"\"\<Selected Topic:\>\"", ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"params", "[", "\"\<topic\>\"", "]"}], ",", 
                    "Bold", ",", 
                    RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}]}], "}"}], ",",
                 "\[IndentingNewLine]", "          ", 
                RowBox[{"{", 
                 RowBox[{"\"\<User Notes:\>\"", ",", 
                  RowBox[{"params", "[", "\"\<notes\>\"", "]"}]}], "}"}]}], 
               "\[IndentingNewLine]", "        ", "}"}], ",", 
              RowBox[{"Alignment", "->", "Left"}], ",", 
              RowBox[{"Spacings", "->", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], 
           "\[IndentingNewLine]", "      ", "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"ImageSize", "->", "400"}]}], "\[IndentingNewLine]", "    ", 
        "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"AppearanceRules", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Title\>\"", 
         "->", "\"\<Dynamic Dependent Category Selector\>\""}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Description\>\"", 
         "->", "\"\<Selecting a Category automatically submits and unlocks \
the corresponding Topic dropdown via TemplateSlot.\>\""}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SubmitLabel\>\"", "->", "\"\<Confirm Selection\>\""}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"PageTheme", "->", "\"\<Light\>\""}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"e3e9bcb1-0a6b-4372-9849-8c375b328c1c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"form", "=", 
   RowBox[{"FormFunction", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"\"\<category\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Science\>\"", ",", "\"\<Arts\>\"", 
          ",", "\"\<Sports\>\""}], "}"}]}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"\"\<topic\>\"", "->", 
        RowBox[{"TemplateExpression", "[", "\[IndentingNewLine]", "      ", 
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{"TemplateSlot", "[", "\"\<category\>\"", "]"}], ",", 
           "\[IndentingNewLine]", "        ", "\"\<Science\>\"", ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Physics\>\"", ",", "\"\<Chemistry\>\"", 
             ",", "\"\<Biology\>\"", ",", "\"\<Astronomy\>\""}], "}"}], ",", 
           "\[IndentingNewLine]", "        ", "\"\<Arts\>\"", ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Literature\>\"", ",", "\"\<Music\>\"", 
             ",", "\"\<Painting\>\"", ",", "\"\<Cinema\>\""}], "}"}], ",", 
           "\[IndentingNewLine]", "        ", "\"\<Sports\>\"", ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Football\>\"", ",", "\"\<Basketball\>\"", 
             ",", "\"\<Tennis\>\"", ",", "\"\<Swimming\>\""}], "}"}], ",", 
           "\[IndentingNewLine]", "        ", "_", ",", 
           RowBox[{"{", "}"}]}], "\[IndentingNewLine]", "      ", "]"}], 
         "\[IndentingNewLine]", "    ", "]"}]}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"\"\<notes\>\"", "->", "\"\<String\>\""}]}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"params", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Panel", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"Column", "[", 
          RowBox[{"{", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<Selection Summary\>\"", ",", "Bold", ",", "16"}], 
             "]"}], ",", "\[IndentingNewLine]", "        ", 
            RowBox[{"Spacer", "[", "5", "]"}], ",", "\[IndentingNewLine]", 
            "        ", 
            RowBox[{"Grid", "[", 
             RowBox[{
              RowBox[{"{", "\[IndentingNewLine]", "          ", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<Selected Category:\>\"", ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"params", "[", "\"\<category\>\"", "]"}], ",", 
                    "Bold"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
                "          ", 
                RowBox[{"{", 
                 RowBox[{"\"\<Selected Topic:\>\"", ",", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"params", "[", "\"\<topic\>\"", "]"}], ",", 
                    "Bold", ",", 
                    RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}]}], "}"}], ",",
                 "\[IndentingNewLine]", "          ", 
                RowBox[{"{", 
                 RowBox[{"\"\<User Notes:\>\"", ",", 
                  RowBox[{"params", "[", "\"\<notes\>\"", "]"}]}], "}"}]}], 
               "\[IndentingNewLine]", "        ", "}"}], ",", 
              RowBox[{"Alignment", "->", "Left"}], ",", 
              RowBox[{"Spacings", "->", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], 
           "\[IndentingNewLine]", "      ", "}"}], "]"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"ImageSize", "->", "400"}]}], "\[IndentingNewLine]", "    ", 
        "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"AppearanceRules", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Title\>\"", 
         "->", "\"\<Dynamic Dependent Category Selector\>\""}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Description\>\"", 
         "->", "\"\<Selecting a Category automatically submits and unlocks \
the corresponding Topic dropdown via TemplateSlot.\>\""}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SubmitLabel\>\"", "->", "\"\<Confirm Selection\>\""}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PageTheme", "->", "\"\<Blue\>\""}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.002004269258222*^9, 4.002004270068184*^9}, {
  4.002004343643712*^9, 4.002004358342235*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"72a80b20-24ec-48d5-8b9f-46f11265e1e4"],

