Cell["2. Define a Reusable Section Header", "Section",ExpressionUUID->"9263869a-a7bc-4f4d-ac9c-746a006e3184"],

Cell["\<\
A small helper builds a colored section header out of a thin orange bar and \
bold text: \
\>", "CodeText",ExpressionUUID->"40a02f7b-2fd2-4ef4-9031-dba52816a3ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sectionHeader", "[", "text_", "]"}], ":=", 
   RowBox[{"Row", "[", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Orange", ",", 
          RowBox[{"Rectangle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"ImageSize", "->", 
         RowBox[{"{", 
          RowBox[{"5", ",", "16"}], "}"}]}]}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Spacer", "[", "5", "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Style", "[", 
       RowBox[{"text", ",", "Bold", ",", "14", ",", 
        RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "}"}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"a011b821-5ab2-4aa5-a969-6b6b273409c8"],

