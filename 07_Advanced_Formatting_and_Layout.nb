Cell["4. Deploy to the Wolfram Cloud", "Section",ExpressionUUID->"525cc982-288b-4ecc-a82e-3f6d110d6d82"],

Cell["Deploy the estimator: ", "CodeText",ExpressionUUID->"78d57f8e-f8d0-4ee6-ba0e-3f31fd546f8c"],

Cell[BoxData[
 RowBox[{"co", "=", 
  RowBox[{"CloudDeploy", "[", 
   RowBox[{"estimator", ",", 
    RowBox[{"Permissions", "->", "\"\<Public\>\""}]}], "]"}]}]], "Input",Expre\
ssionUUID->"776ba0a9-85c1-484b-a276-414e79366453"],

Cell["Retrieve the URL: ", "CodeText",ExpressionUUID->"12fd6142-b7c0-4e7d-b250-d47c6a5ad065"],

Cell[BoxData[
 RowBox[{"co", "[", "\"\<URL\>\"", "]"}]], "Input",ExpressionUUID->"82377668-2397-4519-a147-804d262377d8"],

Cell["Try It in the Browser", "Subsection",ExpressionUUID->"6ff1956d-383d-4b07-b8fa-9d2ba52b0f54"],

Cell["\<\
1. Notice the three labeled sections and the horizontal rules between them.\
\>", "Text",ExpressionUUID->"30a15d9d-2e22-4cec-8e4e-8650b1960224"],

Cell["\<\
2. Change the budget, currency, and duration, then submit to see the \
formatted cost breakdown. \
\>", "Text",ExpressionUUID->"3bfa7d12-22f5-46f0-89f7-d1dc341beeec"],

