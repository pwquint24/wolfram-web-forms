Notebook[{
Cell["Advanced Formatting and Layout in Web Forms", "Title",ExpressionUUID->"83814ed9-711b-416c-8f81-4e3a72a68334"],

Cell["\<\
This notebook extends the basic FormLayoutFunction examples to produce \
richer, sectioned, and more visually structured web forms. The layout \
machinery is the same Wolfram language primitives used in notebooks \
\[LongDash] Column, Row, Grid, Panel, and Delimiter \[LongDash] so complex, \
multi-panel layouts can be built entirely symbolically. \
\>", "Text",ExpressionUUID->"7fa270ca-f5b3-4cc0-b859-335afd6e71f4"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"9d52ee23-c594-49fd-9b7e-925fb670d446"],

Cell["1. Concepts Demonstrated", "Section",ExpressionUUID->"55fd5e4f-00a0-4aab-9e69-839c245792ba"],

Cell[TextData[{
 StyleBox["Sectioned layouts",
  FontWeight->Bold],
 ": A ",
 "FormLayoutFunction",
 " can group fields into logical sections separated by ",
 "Delimiter",
 ", each headed by a custom header built from ",
 "Style",
 " and small ",
 "Graphics",
 "."
}], "Item",ExpressionUUID->"f2dccb50-513d-474e-9eb9-817a79c7a756"],

Cell[TextData[{
 StyleBox["Grid formatting options",
  FontWeight->Bold],
 ": ",
 "Alignment",
 ", ",
 "Spacings",
 ", ",
 "Dividers",
 ", ",
 "Background",
 ", ",
 "Frame",
 ", and ",
 "ItemSize",
 " give fine-grained control over multi-column field layouts."
}], "Item",ExpressionUUID->"11030123-68a7-4539-89ba-8c027622d219"],

Cell[TextData[{
 "Non-textual ",
 "AppearanceRules",
 ": ",
 Cell[BoxData["\"\<Title\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "b710022f-35f1-4c8e-bc03-139f7b5dfbb3"],
 " and ",
 Cell[BoxData["\"\<Description\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "7878cf7a-b63c-4856-bd46-37e4db00be71"],
 " accept styled or graphical expressions, not just plain strings."
}], "Item",ExpressionUUID->"51dc2766-4ff0-4312-82a2-ad698c853e76"],

Cell[TextData[{
 Cell[BoxData["\"\<ItemLayout\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,
  FontWeight->Bold,ExpressionUUID->"af956564-a150-4084-9111-837108e1e908"],
 ": The ",
 "AppearanceRules",
 " key ",
 Cell[BoxData["\"\<ItemLayout\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "2dedbd15-c1db-4f02-9fc6-4f6b4ff10cb8"],
 " controls how each field's label is positioned relative to its control: ",
 Cell[BoxData["\"\<Vertical\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "8b220a8d-84e1-4ec8-acf1-7235d1600ba7"],
 ", ",
 Cell[BoxData["\"\<Horizontal\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "cf9d6f30-d56a-4872-86ff-986d7243fcd4"],
 ", or ",
 Cell[BoxData["\"\<Inline\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "4980f31b-855d-46aa-a243-81fa2a696983"],
 "."
}], "Item",ExpressionUUID->"3ea68288-2799-4ce8-97c7-eb2b28856a46"],

Cell[TextData[{
 StyleBox["Theming",
  FontWeight->Bold],
 ": ",
 "PageTheme",
 " sets the overall look, and style keys such as ",
 Cell[BoxData["\"\<FormTitleStyle\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "86523f81-f0ca-4548-8ac3-9aff397052ab"],
 " and ",
 Cell[BoxData["\"\<FormDescriptionStyle\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "10e71f64-42da-432f-8883-a20fe40bbd2c"],
 " can further customize headings."
}], "Item",ExpressionUUID->"a4ac31c1-1ea2-463d-b802-0c68ed0ca4f6"],

