Cell["3. Define the Multi-Section Estimator", "Section",ExpressionUUID->"08fc3922-5183-4fc3-a594-336509772536"],

Cell[TextData[{
 "This form organizes six fields into three sections \[LongDash] ",
 StyleBox["Project Details",
  FontWeight->Bold],
 ", ",
 StyleBox["Budget",
  FontWeight->Bold],
 ", and ",
 StyleBox["Timeline",
  FontWeight->Bold],
 " \[LongDash] each rendered by a dedicated ",
 "Grid",
 " with right-aligned labels, separated by ",
 "Delimiter",
 ". "
}], "Text",ExpressionUUID->"3304a669-c918-4dcf-b068-358bb64c649a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"estimator", "=", 
   RowBox[{"FormFunction", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"\"\<projectName\>\"", "->", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<Interpreter\>\"", "->", "\"\<String\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Label\>\"", "->", "\"\<Project Name\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Hint\>\"", "->", "\"\<e.g. Q3 Launch\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Required\>\"", "->", "True"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Input\>\"", "->", "\"\<Q3 Launch\>\""}]}], 
         "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"\"\<category\>\"", "->", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<Interpreter\>\"", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Web App\>\"", ",", "\"\<Data Analysis\>\"", 
             ",", "\"\<Automation\>\""}], "}"}]}], ",", "\[IndentingNewLine]",
           "      ", 
          RowBox[{"\"\<Label\>\"", "->", "\"\<Category\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Control\>\"", "->", "PopupMenu"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Input\>\"", "->", "\"\<Web App\>\""}]}], 
         "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"\"\<budget\>\"", "->", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<Interpreter\>\"", "->", 
           RowBox[{"Restricted", "[", 
            RowBox[{"\"\<Integer\>\"", ",", 
             RowBox[{"{", 
              RowBox[{"1000", ",", "100000"}], "}"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Label\>\"", "->", "\"\<Budget\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Input\>\"", "->", "25000"}]}], "\[IndentingNewLine]", 
         "    ", "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<currency\>\"", "->", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<Interpreter\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<USD ($)\>\"", "->", "\"\<$\>\""}], ",", 
             RowBox[{"\"\<EUR (Euro)\>\"", "->", "\"\<\[Euro]\>\""}], ",", 
             RowBox[{"\"\<GBP (Pound)\>\"", "->", "\"\<\[Sterling]\>\""}]}], 
            "}"}]}], ",", "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Label\>\"", "->", "\"\<Currency\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Control\>\"", "->", "PopupMenu"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Input\>\"", "->", "\"\<USD ($)\>\""}]}], 
         "\[IndentingNewLine]", "    ", "|>"}]}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"\"\<startDate\>\"", "->", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<Interpreter\>\"", "->", "\"\<Date\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Label\>\"", "->", "\"\<Start Date\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Input\>\"", "->", "Today"}]}], "\[IndentingNewLine]", 
         "    ", "|>"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<durationWeeks\>\"", "->", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<Interpreter\>\"", "->", 
           RowBox[{"Restricted", "[", 
            RowBox[{"\"\<Integer\>\"", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "52"}], "}"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Label\>\"", "->", "\"\<Duration (weeks)\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Input\>\"", "->", "8"}]}], "\[IndentingNewLine]", 
         "    ", "|>"}]}]}], "\[IndentingNewLine]", "  ", "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"params", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "weeklyCost", "}"}], ",", "\[IndentingNewLine]", 
         "      ", 
         RowBox[{
          RowBox[{"weeklyCost", "=", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"params", "[", "\"\<budget\>\"", "]"}], "/", 
              RowBox[{"params", "[", "\"\<durationWeeks\>\"", "]"}]}], ",", 
             "0.01"}], "]"}]}], ";", "\[IndentingNewLine]", "      ", 
          RowBox[{"Panel", "[", "\[IndentingNewLine]", "        ", 
           RowBox[{
            RowBox[{"Column", "[", 
             RowBox[{"{", "\[IndentingNewLine]", "          ", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"\"\<Cost Estimate: \>\"", " ", "<>", " ", 
                  RowBox[{"params", "[", "\"\<projectName\>\"", "]"}]}], ",", 
                 "Bold", ",", "18", ",", 
                 RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], ",", 
               "\[IndentingNewLine]", "          ", 
               RowBox[{"Spacer", "[", "5", "]"}], ",", "\[IndentingNewLine]", 
               "          ", 
               RowBox[{"Grid", "[", 
                RowBox[{
                 RowBox[{"{", "\[IndentingNewLine]", "            ", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"\"\<Category:\>\"", ",", 
                    RowBox[{"params", "[", "\"\<category\>\"", "]"}]}], "}"}],
                    ",", "\[IndentingNewLine]", "            ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<Total Budget:\>\"", ",", 
                    RowBox[{
                    RowBox[{"params", "[", "\"\<currency\>\"", "]"}], " ", "<>",
                     " ", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"params", "[", "\"\<budget\>\"", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"10", ",", "2"}], "}"}]}], "]"}], "]"}]}]}], 
                    "}"}], ",", "\[IndentingNewLine]", "            ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<Duration:\>\"", ",", 
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{"params", "[", "\"\<durationWeeks\>\"", "]"}], 
                    "]"}], " ", "<>", " ", "\"\< weeks\>\""}]}], "}"}], ",", 
                   "\[IndentingNewLine]", "            ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<Weekly Run Rate:\>\"", ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"params", "[", "\"\<currency\>\"", "]"}], " ", "<>",
                     " ", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{"weeklyCost", ",", 
                    RowBox[{"{", 
                    RowBox[{"10", ",", "2"}], "}"}]}], "]"}], "]"}]}], ",", 
                    "Bold", ",", 
                    RowBox[{"Darker", "[", "Green", "]"}]}], "]"}]}], "}"}], ",",
                    "\[IndentingNewLine]", "            ", 
                   RowBox[{"{", 
                    RowBox[{"\"\<Start Date:\>\"", ",", 
                    RowBox[{"DateString", "[", 
                    RowBox[{
                    RowBox[{"params", "[", "\"\<startDate\>\"", "]"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"\"\<Month\>\"", ",", "\"\</\>\"", 
                    ",", "\"\<Day\>\"", ",", "\"\</\>\"", 
                    ",", "\"\<Year\>\""}], "}"}]}], "]"}]}], "}"}]}], 
                  "\[IndentingNewLine]", "          ", "}"}], ",", 
                 RowBox[{"Alignment", "->", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"Right", ",", "Left"}], "}"}], ",", "Center"}], 
                   "}"}]}], ",", 
                 RowBox[{"Spacings", "->", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], 
              "\[IndentingNewLine]", "        ", "}"}], "]"}], ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"ImageSize", "->", "400"}]}], "\[IndentingNewLine]", 
           "      ", "]"}]}]}], "\[IndentingNewLine]", "    ", "]"}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"AppearanceRules", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Title\>\"", "->", "\"\<Project Cost Estimator\>\""}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Description\>\"", "->", 
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<A multi-section form with advanced formatting and \
custom layout.\>\"", ",", "Italic", ",", "Gray"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SubmitLabel\>\"", "->", "\"\<Calculate Estimate\>\""}]}],
        "\[IndentingNewLine]", "  ", "|>"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"FormLayoutFunction", "->", 
      RowBox[{"Function", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{"Column", "[", 
        RowBox[{"{", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"sectionHeader", "[", "\"\<PROJECT DETAILS\>\"", "]"}], ",",
           "\[IndentingNewLine]", "      ", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"\"\<projectName\>\"", ",", "\"\<Label\>\""}], "]"}],
                 ",", 
                RowBox[{"#", "[", 
                 RowBox[{"\"\<projectName\>\"", ",", "\"\<Control\>\""}], 
                 "]"}]}], "}"}], ",", "\[IndentingNewLine]", "        ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"\"\<category\>\"", ",", "\"\<Label\>\""}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"\"\<category\>\"", ",", "\"\<Control\>\""}], 
                 "]"}]}], "}"}]}], "\[IndentingNewLine]", "      ", "}"}], ",", 
            RowBox[{"Alignment", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Right", ",", "Left"}], "}"}], ",", "Center"}], 
              "}"}]}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", "      ", "Delimiter", ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"sectionHeader", "[", "\"\<BUDGET\>\"", "]"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"\"\<budget\>\"", ",", "\"\<Label\>\""}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"\"\<budget\>\"", ",", "\"\<Control\>\""}], "]"}]}], 
               "}"}], ",", "\[IndentingNewLine]", "        ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"\"\<currency\>\"", ",", "\"\<Label\>\""}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"\"\<currency\>\"", ",", "\"\<Control\>\""}], 
                 "]"}]}], "}"}]}], "\[IndentingNewLine]", "      ", "}"}], ",", 
            RowBox[{"Alignment", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Right", ",", "Left"}], "}"}], ",", "Center"}], 
              "}"}]}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}], ",", 
          "\[IndentingNewLine]", "      ", "Delimiter", ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"sectionHeader", "[", "\"\<TIMELINE\>\"", "]"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"Grid", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"\"\<startDate\>\"", ",", "\"\<Label\>\""}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"\"\<startDate\>\"", ",", "\"\<Control\>\""}], 
                 "]"}]}], "}"}], ",", "\[IndentingNewLine]", "        ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"\"\<durationWeeks\>\"", ",", "\"\<Label\>\""}], 
                 "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"\"\<durationWeeks\>\"", ",", "\"\<Control\>\""}], 
                 "]"}]}], "}"}]}], "\[IndentingNewLine]", "      ", "}"}], ",", 
            RowBox[{"Alignment", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"Right", ",", "Left"}], "}"}], ",", "Center"}], 
              "}"}]}], ",", 
            RowBox[{"Spacings", "->", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]}]}], "]"}]}], 
         "\[IndentingNewLine]", "    ", "}"}], "]"}], "\[IndentingNewLine]", 
       "  ", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"PageTheme", "->", "\"\<Light\>\""}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"1c978ef6-a71e-4090-8e27-\
7075c522251e"],

Cell["Notes on the Layout", "Subsection",ExpressionUUID->"2990927d-2c0f-41c6-a906-0b173f17e0db"],

Cell[TextData[{
 "Each section is a ",
 "Grid",
 " with ",
 Cell[BoxData[
  RowBox[{"Alignment", "->", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Right", ",", "Left"}], "}"}], ",", "Center"}], "}"}]}]], 
  "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "56fed36f-2d34-4837-8e97-5e8600c6e6d6"],
 " so labels sit flush right and controls flush left."
}], "Item",ExpressionUUID->"663dd0a9-9537-4dbd-8b7f-bfa526c71051"],

Cell["Delimiter inserts a horizontal rule between sections.", "Item",ExpressionUUID->"9b978f29-2a10-4c47-b7a2-27eceb5a2dae"],

Cell[TextData[{
 Cell[BoxData[Cell["#[\"key\", \"Label\"]",
   Background->None,ExpressionUUID->"f13cc3b7-574b-4787-b16a-6a50c6e51f93"]], 
  "InlineCode",ExpressionUUID->"77e0395b-914a-4daa-8137-9e13a8153dd2"],
 " and ",
 Cell[BoxData[Cell["#[\"key\", \"Control\"]",
   Background->None,ExpressionUUID->"fe36cb8f-431c-41af-bb8b-167aa5e03bfe"]], 
  "InlineCode",ExpressionUUID->"a2d75919-9339-4c5f-98bd-34cf1fe0420a"],
 " extract the label and bare input element for each field."
}], "Item",ExpressionUUID->"0919a2cc-1911-4cbe-aa5c-b9417bb82578"],

Cell[TextData[{
 "The ",
 Cell[BoxData["\"\<Currency\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "dd6d3afc-51e3-4b84-a648-26a8175a7e34"],
 " interpreter maps human-readable popup labels (",
 Cell[BoxData["\"\<USD ($)\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "1bf2ef97-eb4a-43b8-8bbb-5ef3e2b6dfb3"],
 ") to symbols (",
 Cell[BoxData["\"\<$\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "256cfd13-2665-431f-94d1-3a67c8c5b7cd"],
 ") that are used in the result calculation."
}], "Item",ExpressionUUID->"3ff9cc74-dfcd-47e4-b15f-49e9b955e408"],

