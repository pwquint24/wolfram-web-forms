Notebook[{

Cell[CellGroupData[{
Cell["Persistent Forms with FormPage", "Title",ExpressionUUID->"6db50079-238b-4adc-829e-ced301a093e8"],

Cell["\<\
This notebook demonstrates FormPage, which displays both the input form and \
the computational result on the same web page. \
\>", "Text",ExpressionUUID->"bfcc859f-2888-4848-ba79-3545fa14d68d"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"b5cef393-6e88-47a7-ad0e-e43044710052"],

Cell[CellGroupData[{

Cell["1. Concepts Demonstrated", "Section",ExpressionUUID->"5e963e8e-eb93-4d70-a0be-88609e4e8101"],

Cell[CellGroupData[{

Cell["FormPage vs. FormFunction:", "Item",ExpressionUUID->"ee92d78f-4d70-4c4a-9f92-1f457d21ec40"],

Cell["\<\
FormFunction displays a form, and upon submission replaces the page entirely \
with the output.\
\>", "Subitem",ExpressionUUID->"fe10711f-748c-4ea8-9fed-f1a22f4c416b"],

Cell["\<\
FormPage keeps both the input controls and the resulting output visible on \
the same page. After submission, users can adjust parameters and resubmit \
immediately.\
\>", "Subitem",ExpressionUUID->"79c9d1af-22f8-4d68-9c18-47c855d590e0"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Layout Specification",
  FontWeight->Bold],
 ": The third argument can be ",
 Cell[BoxData["\"\<ResultBelow\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "948534c3-2b7d-4517-b87f-ad59c5c98c31"],
 " or ",
 Cell[BoxData["\"\<ResultAbove\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "339a08ea-6f23-48e2-8ebf-3a35f41558ee"],
 " to control where the output appears relative to the form."
}], "Item",ExpressionUUID->"98ba0d08-449a-4d80-bb18-7c7c7ac4eb58"],

Cell[TextData[{
 StyleBox["Enumeration and Function Mapping",
  FontWeight->Bold],
 ": Form choices can map human-readable labels to symbolic functions (e.g., \
",
 Cell[BoxData[Cell["\"Sine Wave\" -> Sin",
   Background->None,ExpressionUUID->"260595d9-4ab6-4fc5-b249-75a79579d134"]], 
  "InlineCode",ExpressionUUID->"bfbae836-3c0e-4f71-b02b-38ed903fd150"],
 ")."
}], "Item",ExpressionUUID->"f418ca37-0896-4e78-9cf7-2a983368cce1"],

Cell[TextData[{
 StyleBox["Styling and Theming",
  FontWeight->Bold],
 ": Using ",
 Cell[BoxData[
  RowBox[{"PageTheme", "->", "\"\<Navy\>\""}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "e223d954-64e2-4d2d-9bcf-d1fde9899f4d"],
 " and ",
 "AppearanceRules",
 " to create a polished dashboard look."
}], "Item",ExpressionUUID->"bd2ba934-3b11-4fc5-9a7b-85f3bc5e5d2a"],

Cell[TextData[{
 StyleBox["Cloud Deployment and Cleanup",
  FontWeight->Bold],
 ": Using ",
 "CloudDeploy",
 " and ",
 "DeleteObject",
 "."
}], "Item",ExpressionUUID->"616b78f3-486a-4df0-9bcf-f483f71aff3b"],

