Cell[CellGroupData[{

Cell["2. Define the FormPage", "Section",ExpressionUUID->"d52b0fe7-8c56-4f5d-a4f6-722048f85a77"],

Cell["\<\
This form implements an interactive mathematical waveform visualizer. Users \
choose a waveform type, frequency multiplier, range, and plot color. \
\>", "Text",ExpressionUUID->"f0decf30-d489-4040-aa94-520f9dcfa315"],

Cell[BoxData[
 RowBox[{
  RowBox[{"page", "=", 
   RowBox[{"FormPage", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<function\>\"", ",", "\"\<Waveform Type:\>\""}], "}"}], "->", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Sine Wave\>\"", "->", "Sin"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Damped Sine\>\"", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "#"}], "/", "5"}], "]"}], "*", 
               RowBox[{"Sin", "[", "#", "]"}]}], " ", "&"}], ")"}]}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Cosine Wave\>\"", "->", "Cos"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Sinc Wave\>\"", "->", "Sinc"}]}], 
          "\[IndentingNewLine]", "    ", "}"}], "->", "Sin"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<frequency\>\"", ",", "\"\<Frequency Multiplier:\>\""}], 
         "}"}], "->", 
        RowBox[{
         RowBox[{"Restricted", "[", 
          RowBox[{"\"\<Number\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"0.1", ",", "10."}], "}"}]}], "]"}], "->", "1.0"}]}], ",",
        "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<range\>\"", ",", "\"\<Plot Range (0 to X):\>\""}], 
         "}"}], "->", 
        RowBox[{
         RowBox[{"Restricted", "[", 
          RowBox[{"\"\<Number\>\"", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "*", "Pi"}], ",", 
             RowBox[{"10", "*", "Pi"}]}], "}"}]}], "]"}], "->", 
         RowBox[{"4", "*", "Pi"}]}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<lineColor\>\"", ",", "\"\<Waveform Color:\>\""}], "}"}],
         "->", 
        RowBox[{"\"\<Color\>\"", "->", "Blue"}]}]}], "\[IndentingNewLine]", 
      "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"params", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Plot", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"params", "[", "\"\<function\>\"", "]"}], "[", 
          RowBox[{
           RowBox[{"params", "[", "\"\<frequency\>\"", "]"}], "*", "x"}], 
          "]"}], ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", 
           RowBox[{"params", "[", "\"\<range\>\"", "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Thick", ",", 
            RowBox[{"params", "[", "\"\<lineColor\>\"", "]"}]}], "}"}]}], ",",
          "\[IndentingNewLine]", "      ", 
         RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
         "      ", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", "\[IndentingNewLine]",
          "      ", 
         RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
         "      ", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<f(x)\>\""}], "}"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Waveform Analysis\>\"", ",", "Bold", ",", "14"}], 
           "]"}]}], ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"ImageSize", "->", "550"}]}], "\[IndentingNewLine]", "    ", 
        "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", "\"\<ResultBelow\>\"", ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"AppearanceRules", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Title\>\"", 
         "->", "\"\<Interactive Waveform Visualizer\>\""}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Description\>\"", 
         "->", "\"\<Adjust parameters below. The plot updates on the same \
page upon submission.\>\""}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SubmitLabel\>\"", "->", "\"\<Update Plot\>\""}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"PageTheme", "->", "\"\<Navy\>\""}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"b4a29bc1-f237-4e5c-bf23-671c1ea851cc"],

