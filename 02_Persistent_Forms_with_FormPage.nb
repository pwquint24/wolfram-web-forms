Cell["3. Deploy to the Wolfram Cloud", "Section",ExpressionUUID->"14a1396f-4ae0-4a52-85e4-bee5e091f02e"],

Cell[TextData[{
 "Deploy the ",
 Cell[BoxData[
  TemplateBox[{
   "FormPage", "paclet:ref/FormPage", 
    "https://reference.wolfram.com/language/ref/FormPage.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
