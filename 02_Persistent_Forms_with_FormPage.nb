Cell[CellGroupData[{

Cell["2. Define the FormPage", "Section",ExpressionUUID->"d52b0fe7-8c56-4f5d-a4f6-722048f85a77"],

Cell["\<\
This form implements an interactive mathematical waveform visualizer. Users \
choose a waveform type, frequency multiplier, range, and plot color. \
\>", "Text",ExpressionUUID->"f0decf30-d489-4040-aa94-520f9dcfa315"],

Cell[BoxData[
 RowBox[{
  RowBox[{"page", "=", 
   RowBox[{"FormPage", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<function\>\"", ",", "\"\<Waveform Type:\>\""}], "}"}], "->", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Sine Wave\>\"", "->", "Sin"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Damped Sine\>\"", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "#"}], "/", "5"}], "]"}], "*", 
               RowBox[{"Sin", "[", "#", "]"}]}], " ", "&"}], ")"}]}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Cosine Wave\>\"", "->", "Cos"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<Sinc Wave\>\"", "->", "Sinc"}]}], 
          "\[IndentingNewLine]", "    ", "}"}], "->", "Sin"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<frequency\>\"", ",", "\"\<Frequency Multiplier:\>\""}], 
         "}"}], "->", 
        RowBox[{
         RowBox[{"Restricted", "[", 
          RowBox[{"\"\<Number\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"0.1", ",", "10."}], "}"}]}], "]"}], "->", "1.0"}]}], ",",
        "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<range\>\"", ",", "\"\<Plot Range (0 to X):\>\""}], 
         "}"}], "->", 
        RowBox[{
         RowBox[{"Restricted", "[", 
          RowBox[{"\"\<Number\>\"", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "*", "Pi"}], ",", 
             RowBox[{"10", "*", "Pi"}]}], "}"}]}], "]"}], "->", 
         RowBox[{"4", "*", "Pi"}]}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<lineColor\>\"", ",", "\"\<Waveform Color:\>\""}], "}"}],
         "->", 
        RowBox[{"\"\<Color\>\"", "->", "Blue"}]}]}], "\[IndentingNewLine]", 
      "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Function", "[", 
      RowBox[{"params", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"Plot", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"params", "[", "\"\<function\>\"", "]"}], "[", 
          RowBox[{
           RowBox[{"params", "[", "\"\<frequency\>\"", "]"}], "*", "x"}], 
          "]"}], ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", 
           RowBox[{"params", "[", "\"\<range\>\"", "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Thick", ",", 
            RowBox[{"params", "[", "\"\<lineColor\>\"", "]"}]}], "}"}]}], ",",
          "\[IndentingNewLine]", "      ", 
         RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
         "      ", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", "\[IndentingNewLine]",
          "      ", 
         RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
         "      ", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<f(x)\>\""}], "}"}]}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Waveform Analysis\>\"", ",", "Bold", ",", "14"}], 
           "]"}]}], ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"ImageSize", "->", "550"}]}], "\[IndentingNewLine]", "    ", 
        "]"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", "\"\<ResultBelow\>\"", ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"AppearanceRules", "->", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Title\>\"", 
         "->", "\"\<Interactive Waveform Visualizer\>\""}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Description\>\"", 
         "->", "\"\<Adjust parameters below. The plot updates on the same \
page upon submission.\>\""}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<SubmitLabel\>\"", "->", "\"\<Update Plot\>\""}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"PageTheme", "->", "\"\<Navy\>\""}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"b4a29bc1-f237-4e5c-bf23-671c1ea851cc"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"79a56fec-7fe0-438b-b7fc-758aeb4fc5b5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Deploy to the Wolfram Cloud", "Section",ExpressionUUID->"14a1396f-4ae0-4a52-85e4-bee5e091f02e"],

Cell["\<\
Deploy the FormPage to the Wolfram Cloud with public permissions: \
\>", "CodeText",ExpressionUUID->"9e1ebb6d-d8fe-47f3-93e0-cac690c0e54d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"co", "=", 
  RowBox[{"CloudDeploy", "[", 
   RowBox[{"page", ",", 
    RowBox[{"Permissions", "->", "\"\<Public\>\""}]}], "]"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"76773ead-095e-44d7-8ae1-f4c3cdbae617"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"CloudObject", "[", 
   TemplateBox[{
    "\"https://www.wolframcloud.com/obj/540e13ab-0c08-4c68-9d56-15bdd81bd882\"\
", "https://www.wolframcloud.com/obj/540e13ab-0c08-4c68-9d56-15bdd81bd882"},
    "HyperlinkURL"], "]"}],
  CloudObject[
  "https://www.wolframcloud.com/obj/540e13ab-0c08-4c68-9d56-15bdd81bd882"],
  SelectWithContents->True]], "Output",
 CellChangeTimes->{4.00191384461863*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"115c49bd-2a5e-4f83-b6d3-651cc5ef88f0"]
}, Open  ]],

Cell["Retrieve and visit the web address: ", "CodeText",ExpressionUUID->"5e659aa4-0145-49f3-bc16-eb8546801b9f"],

Cell[BoxData[
 RowBox[{"co", "[", "\"\<URL\>\"", "]"}]], "Input",ExpressionUUID->"227e933e-0868-4f9a-a175-f87db19132ff"],

Cell["Notice when you open the URL:", "Text",ExpressionUUID->"2fdf684b-2a17-4f79-9026-c42e7110acf3"],

Cell["1. An initial form is displayed.", "Text",ExpressionUUID->"0aac1b09-26e1-44a3-829c-005584d417af"],

Cell["\<\
2. After submitting, your plot appears beneath the form, while the form \
fields retain your values so you can tweak them and re-submit immediately. \
\>", "Text",ExpressionUUID->"8ef4607f-c7a5-4aee-b7b9-8578680b46c6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"d1208ff6-345c-4eb3-ad72-ae2ef3308973"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Delete the Cloud Object", "Section",ExpressionUUID->"ae7e42b1-3988-4e05-ab0b-670eee813b43"],

Cell["To remove the deployed web form from the cloud: ", "CodeText",ExpressionUUID->"e1876414-b273-4a71-8230-7febc253e1e2"],

Cell[BoxData[
 RowBox[{"DeleteObject", "[", "co", "]"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"3296093a-e292-409f-8ca3-eb48f3887623"]
}, Open  ]]
}, Open  ]]
